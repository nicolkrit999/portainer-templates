# Timezone
TZ=America/New_York

# Host UID/GID the container runs as; the bind-mounted data/config dirs
# must be writable by this user
PUID=1000
PGID=1000

# Fast-storage root; Gokapi's data and config both live under it
VOLUME_CONFIG=/opt/docker

# Traefik subdomain (defaults to the service directory name)
GOKAPI_SUBDOMAIN=gokapi

# Proxies whose X-Forwarded-For / X-Real-IP Gokapi trusts: the
# traefik-proxy network subnet (private Traefik) and the public-gokapi
# backend network subnet (traefik-public). Comma-separated IPs/CIDRs.
GOKAPI_TRUSTED_PROXIES=172.27.0.0/16,172.16.80.0/28

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_4=friends
TRAEFIK_ENTRYPOINT_7=tailnet-admin
