TZ=Europe/London

# User/group IDs
PUID=1000
PGID=1000

# Web UI port
WEBUI_PORT=9865

# Volume base paths (fast/SSD-class config storage, bulk/HDD-class data
# storage) - qbit-torrent's config lives at ${VOLUME_CONFIG}/qbit-torrent/config
# and its downloads at ${VOLUME_DATA}/qbit-torrent/downloads on the host.
VOLUME_CONFIG=/volume2/docker
VOLUME_DATA=/volume1/Default-volume-1/0001_Docker

# Traefik private-tier router hostname segment (qbit-torrent.${DOMAIN})
QBIT_TORRENT_SUBDOMAIN=qbit-torrent

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
