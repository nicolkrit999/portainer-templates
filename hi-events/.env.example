# Volume base paths (this repo's convention: fast/SSD config vs bulk/HDD data)
VOLUME_CONFIG=/opt/docker
VOLUME_DATA=/opt/docker-data

# Timezone for the all-in-one backend
TZ=Etc/UTC

# Traefik private-tier subdomain - explicit override, NOT the directory name
# (this service's live hostname is "eventi", not "hi-events")
HI_EVENTS_SUBDOMAIN=eventi

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_4=friends
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# Postgres superuser password (also used in all-in-one's DATABASE_URL)
POSTGRES_PASSWORD=change-me

# Laravel-style app encryption key for the all-in-one backend
APP_KEY=your-app-key-here

# JWT signing secret for the all-in-one backend
JWT_SECRET=change-me

# Log channel for the all-in-one backend
LOG_CHANNEL=stderr

# Queue driver for the all-in-one backend
QUEUE_CONNECTION=redis

# Proxies allowed to set X-Forwarded-For. "*" trusts only the connection peer
# (the Traefik instance), which is what a single proxy hop needs. Several hops
# or a CDN: list every hop (comma-separated IPs/CIDRs, "cloudflare" adds its ranges).
APP_TRUSTED_PROXIES=*

# SaaS mode / Stripe Connect application fee settings (single-tenant default: off)
APP_SAAS_MODE_ENABLED=false
APP_SAAS_STRIPE_APPLICATION_FEE_PERCENT=0
APP_SAAS_STRIPE_APPLICATION_FEE_FIXED=0

# Branding shown in the frontend UI and outbound emails
VITE_APP_NAME=Hi.Events

# Logo shown in outbound emails, and the URL it links to. Write full URLs:
# Portainer does not expand ${VAR} inside a stack variable value. Empty = no logo.
APP_EMAIL_LOGO_URL=https://eventi.example.com/logo.png
APP_EMAIL_LOGO_LINK_URL=https://eventi.example.com

# SMTP outbound mail settings
MAIL_MAILER=smtp
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username-here
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=events@example.com
MAIL_FROM_NAME=Hi.Events

# Laravel filesystem disk names
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PRIVATE_DISK=local

# Stripe publishable key (public, safe to expose client-side - not a secret,
# still templated per repo convention)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key_here

# Stripe secret key and webhook signing secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
