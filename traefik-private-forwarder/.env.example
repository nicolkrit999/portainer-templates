# Dedicated LAN IP for this TCP-forwarder sidecar, so the household member
# has a clean hostname:443 URL for private-tier Traefik access with no port
# number. Must be a free, static IP outside your router's DHCP pool.
TRAEFIK_PRIVATE_IP=192.168.1.99

# Host network interface the macvlan network attaches to (same interface
# used by other macvlan services in this repo, e.g. adguard).
LAN_INTERFACE=eth0

# LAN subnet and gateway for the macvlan network.
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# Container-internal port Traefik's private-tier entrypoint listens on
# (must match TRAEFIK_PORT_3 in the traefik stack's own env - this sidecar
# forwards raw TCP to traefik:${TRAEFIK_PORT_3}).
TRAEFIK_PORT_3=8444
