# Dedicated LAN IP for this TCP-forwarder sidecar, so the household member
# has a clean hostname:443 URL for private-tier Traefik access with no port
# number. Must be a free, static IP outside your router's DHCP pool.
TRAEFIK_PRIVATE_IP=192.168.1.99

# Host network interface the macvlan network attaches to. NOTE: this is
# bridge0, not eth0, once UGOS's "Virtual Network Bridging" is enabled -
# that feature enslaves the physical NIC under a bridge interface that
# takes over its L2 identity, and macvlan must attach to that bridge, not
# the now-enslaved eth0 (confirmed via a real "device or resource busy"
# deploy failure when this was still eth0). Same applies to adguard's own
# still-deferred macvlan plan if/when that gets revisited.
LAN_INTERFACE=bridge0

# LAN subnet and gateway for the macvlan network.
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# Container-internal port Traefik's private-tier entrypoint listens on
# (must match TRAEFIK_PORT_3 in the traefik stack's own env - this sidecar
# forwards raw TCP to traefik:${TRAEFIK_PORT_3}).
TRAEFIK_PORT_3=8444
