DOCKER_CONFIG_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker-data
TZ=Europe/London

# User/group IDs
PUID=1000
PGID=1000

# qbittorrent's Web UI port
WEBUI_PORT=9865

# Traefik private-tier router hostname segment (qbit-torrent.${DOMAIN})
QBIT_TORRENT_SUBDOMAIN=qbit-torrent

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# Reusable (non-ephemeral) Tailscale pre-auth key for this node, generated
# manually via the Tailscale admin console (Settings -> Keys). Tag it
# appropriately there if your tailnet uses ACL tags. Set the real value
# directly in Portainer - never commit it here.
TS_AUTHKEY_QBITTORRENT=your-tailscale-preauth-key-here

# Distinct, human-readable node name for this Tailscale identity, so it's
# clearly identifiable (and separately approvable) in the admin console,
# distinct from every other node in this repo (../tailscale/,
# ../tailscale-adguard/, ../tailscale-admin_traefik-tailnet-forwarder/).
TS_HOSTNAME_QBITTORRENT=tailscale-qbittorrent

# Mullvad exit node this identity always routes through - a specific,
# deliberately chosen node (Spain/Barcelona, es-bcn-wg-001), not a
# rotating/auto selection. Change only if you deliberately want a
# different fixed exit node; see your Tailscale admin console's Exit
# Nodes list (under the Mullvad-provided nodes) for other valid nodes.
#
# MUST be a Tailscale IP address, not a .ts.net hostname. On first boot
# (no cached netmap/MagicDNS data yet, brand-new device identity),
# `tailscale up --exit-node=<hostname>` fails outright with: "cannot
# resolve exit node by hostname while Tailscale is starting up; please
# use its Tailscale IP address instead" - hostname resolution itself
# depends on the tailnet connection that `tailscale up` is still in the
# middle of establishing. Look up the IP for a given node via
# `tailscale exit-node list --filter=<region>` on an already-connected
# device. es-bcn-wg-001.mullvad.ts.net = 100.123.96.89 (confirmed
# 2026-09-24).
MULLVAD_EXIT_NODE=100.123.96.89

# Volume base path (fast/SSD-class config storage) - this node's Tailscale
# state lives at ${VOLUME_CONFIG}/tailscale-qbittorrent/state on the host.
VOLUME_CONFIG=/volume2/docker
