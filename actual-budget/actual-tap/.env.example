# Timezone
TZ=America/New_York

# Actual Budget connection (the server URL is fixed in the compose to http://ActualBudget:5006
# over the actual-backend network, which the actual-server_actual-https-api stack creates)
ACTUAL_PASSWORD=your-actual-main-password
ACTUAL_SYNC_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
API_KEY=your-api-key-here
ACTUAL_ENCRYPTION_PASSWORD=your-encryption-password

# Traefik reverse proxy
ACTUAL_TAP_SUBDOMAIN=budget-tap

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
