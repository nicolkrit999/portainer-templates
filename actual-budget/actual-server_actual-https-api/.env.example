# Timezone
TZ=America/New_York

# Base domain (used for the Traefik router hostname ${ACTUAL_BUDGET_SUBDOMAIN}.DOMAIN)
DOMAIN=example.com

# Traefik router config
TRAEFIK_ENTRYPOINT_1=family
ACTUAL_BUDGET_SUBDOMAIN=budget
ACTUAL_API_SUBDOMAIN=budget-api

# Sibling hostnames, needed here only to bundle their certs onto this
# router's SAN-bundle TLS cert (Let's Encrypt rate-limit mitigation).
# Values copied exactly from each sibling's own .env.example - do not
# invent different defaults.
ACTUAL_ICAL_SUBDOMAIN=budget-ical
ACTUAL_TAP_SUBDOMAIN=budget-tap

# Actual Budget API secrets
ACTUAL_SERVER_PASSWORD=your-actual-server-password
ACTUAL_API_PASSWORD=your-api-key-here

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
TRAEFIK_ENTRYPOINT_3=private
