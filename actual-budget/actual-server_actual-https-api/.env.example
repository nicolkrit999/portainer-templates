# Timezone
TZ=America/New_York

# Base domain (used for the Traefik router hostname ${ACTUAL_BUDGET_SUBDOMAIN}.DOMAIN)
DOMAIN=example.com

# Traefik router config
ACTUAL_BUDGET_SUBDOMAIN=budget
# ActualAPI hostname segment; private and tailnet-admin routers only (not internet-facing)
ACTUAL_API_SUBDOMAIN=budget-api

# Actual Budget API secrets
ACTUAL_SERVER_PASSWORD=your-actual-server-password
ACTUAL_API_PASSWORD=your-api-key-here

# Optional: comma-separated budget sync ids ActualAPI may serve on its per-budget routes
# (403 for any other id). Empty means no restriction. It does not hide the budget list route.
ACTUAL_API_ALLOWED_BUDGET_SYNC_IDS=

# Proxies whose X-Forwarded-For the Actual server trusts (rate limits and login throttle key on it):
# ONLY the public Traefik's fixed address on public-budget (.2). The private tier and the other
# networks are deliberately not trusted: a container there could otherwise forge the client IP and
# dodge the login throttle. Must match PUBLIC_BUDGET_PROXY_IP in the traefik-public stack.
ACTUAL_TRUSTED_PROXIES=172.16.93.2

# Backend network shared by the Actual server, ActualAPI and ActualTap (internal, created by this stack).
ACTUAL_BACKEND_SUBNET=172.16.93.16/28
ACTUAL_BACKEND_GATEWAY=172.16.93.17
ACTUAL_BACKEND_IP_RANGE=172.16.93.24/29

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
