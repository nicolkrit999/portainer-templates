# Timezone
TZ=America/New_York

# Base domain (used for the Traefik router hostname ${ACTUAL_BUDGET_SUBDOMAIN}.DOMAIN)
DOMAIN=example.com

# Traefik router config
TRAEFIK_ENTRYPOINT_1=family
ACTUAL_BUDGET_SUBDOMAIN=budget

# Actual Budget API secrets
ACTUAL_SERVER_PASSWORD=your-actual-server-password
ACTUAL_API_PASSWORD=your-api-key-here

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
