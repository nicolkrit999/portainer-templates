TZ=Europe/London

# Traefik private-tier router hostname segment (glances.${DOMAIN})
GLANCES_SUBDOMAIN=glances

# LAN IP of the host - glances uses network_mode: host so Traefik must reach
# it via the host's IP rather than a Docker-network container address
NAS_IP=192.168.1.98

# SAN-bundle group "infra-ops" - this stack is the anchor, so its own .env
# needs a subdomain var for every OTHER member of the group
PORTAINER_SUBDOMAIN=portainer
COOLIFY_SUBDOMAIN=coolify
SOKETI_SUBDOMAIN=soketi-coolify
GITEA_SUBDOMAIN=gitea
TUGTAINER_SUBDOMAIN=tugtainer
DOCKPEEK_SUBDOMAIN=dockpeek
HARBORGUARD_SUBDOMAIN=harborguard
BESZEL_SUBDOMAIN=beszel
UPTIME_KUMA_SUBDOMAIN=uptime-kuma
GLANCE_SUBDOMAIN=glance
GOCRON_SUBDOMAIN=gocron
N8N_SUBDOMAIN=n8n
POCKET_ID_SUBDOMAIN=pocket-id
ADGUARD_SUBDOMAIN=adguard
UPSNAP_SUBDOMAIN=upsnap
APPRISE_API_SUBDOMAIN=apprise-api
GOTIFY_SUBDOMAIN=gotify
WEB_CHECK_SUBDOMAIN=web-check
MAILPIT_SUBDOMAIN=mailpit
PHPLDAPADMIN_SUBDOMAIN=phpldapadmin
TRAEFIK_DASHBOARD_SUBDOMAIN=traefik

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
