# Timezone
TZ=America/New_York

# MySQL database credentials
MYSQL_ROOT_PASSWORD=your-root-password-here
MYSQL_DATABASE=ghost
MYSQL_USER=ghostuser
MYSQL_PASSWORD=your-db-password-here

# Ghost public URL
GHOST_URL=https://blog.example.com

# SMTP mail settings
MAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Volume base paths
DOCKER_DATA_DIR=/opt/docker-data

# Hostname segment for the private (LAN) and tailnet routers (blog.${DOMAIN})
GHOST_SUBDOMAIN=blog

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# OPTIONAL (defaults shown). ghost-backend network (internal; a /28 from the registry, proxy-research findings/subnets.md)
GHOST_BACKEND_SUBNET=172.16.107.0/28
GHOST_BACKEND_GATEWAY=172.16.107.1
GHOST_BACKEND_IP_RANGE=172.16.107.8/29
