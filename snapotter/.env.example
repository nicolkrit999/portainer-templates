# Timezone
TZ=America/New_York

# Volume base paths: data pool (HDD, read-only AI models) and config pool (SSD, logs/redis/postgres)
DOCKER_DATA_DIR=/opt/docker-data
DOCKER_CONFIG_DIR=/opt/docker

# Traefik hostname segment (snapotter.${DOMAIN})
SNAPOTTER_SUBDOMAIN=snapotter

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
