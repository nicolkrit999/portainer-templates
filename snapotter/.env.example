# Timezone
TZ=America/New_York

# Volume base paths
DOCKER_DATA_DIR=/opt/docker-data

# Traefik private-tier router hostname segment (snapotter.${DOMAIN})
SNAPOTTER_SUBDOMAIN=snapotter

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
SNAPOTTER_PASSWORD=your-snapotter-password-here
