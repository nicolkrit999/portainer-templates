LAN_INTERFACE=bridge0
MACVLAN_SHIM_IFACE=macvlan-shim0
MACVLAN_SHIM_IP=192.168.1.95
NAS_IP=192.168.1.98
# Comma-separated list of macvlan-attached container IPs that need shim-routed
# reachability (a /32 host route via ${MACVLAN_SHIM_IFACE}) - see docker-compose.yml's
# "A HOST ROUTE IS ALSO REQUIRED" comment for why. Update this whenever a new
# macvlan-attached service gets its own static IP on this shim's segment -
# analogous to the per-hostname override list dnsmasq/docker-compose.yml requires
# for a similar reason (a new consumer means one more required list entry, not
# something that "just works" automatically).
MACVLAN_ATTACHED_IPS=192.168.1.96
