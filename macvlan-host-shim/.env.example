# Parent physical/bridge interface for the macvlan L2 segment. Must match
# the SAME value already used by traefik-private-forwarder's macvlan
# network (this instance: the NAS's bridge interface, bridge0) - the shim
# only works if it shares the exact same L2 segment as the macvlan-attached
# containers it's bridging the host into.
LAN_INTERFACE=bridge0

# Name of the shim network interface this container creates in the host's
# own network namespace. Purely cosmetic/internal - pick anything that
# won't collide with a real interface name on the host.
MACVLAN_SHIM_IFACE=macvlan-shim0

# Static IP address assigned to the shim interface. Must be a free,
# unused address on the same LAN subnet as the macvlan network (this
# instance: verified free against a live DHCP export, 192.168.1.95 on the
# 192.168.1.0/24 segment). Never reuse an address already claimed by
# another host, DHCP reservation, or another macvlan-attached container
# (e.g. adguard's 192.168.1.96, or traefik-private-forwarder's own IP).
MACVLAN_SHIM_IP=192.168.1.95

# Real LAN IP of the NAS host itself (the parent interface's own address -
# where the real dnsmasq is bound on port 53). This container relays DNS
# traffic from MACVLAN_SHIM_IP to this address, since macvlan-attached
# containers can never reach it directly - see the compose file's top
# comment for the full explanation. Repo-wide var, same value used by
# every other service that references the NAS's own LAN IP.
NAS_IP=192.168.1.98
