# Reusable (non-ephemeral) Tailscale pre-auth key for this node, generated
# manually via the Tailscale admin console (Settings -> Keys). Tag it
# appropriately there if your tailnet uses ACL tags. Set the real value
# directly in Portainer - never commit it here.
TS_AUTHKEY_ADGUARD=your-tailscale-preauth-key-here

# Distinct, human-readable node name for this Tailscale identity, so it's
# clearly identifiable (and separately approvable) in the admin console,
# distinct from the primary node in ../tailscale/ and the admin-gateway
# node in ../tailscale-admin_traefik-tailnet-forwarder/ (merged 2026-09-08,
# was a separate ../tailscale-admin/ stack before). This is the name you'll
# look for when picking the tailnet's DNS-server IP in the admin console's
# DNS settings.
TS_HOSTNAME_ADGUARD=adguard-dns

# Volume base path (fast/SSD-class config storage) - this node's Tailscale
# state lives at ${VOLUME_CONFIG}/tailscale-adguard/state on the host, and
# the dnsdist canary's generated YAML config lives at
# ${VOLUME_CONFIG}/tailscale-adguard/dnsdist-canary.yml.
VOLUME_CONFIG=/volume2/docker

# Static IP for this node on the traefik-proxy Docker network - kept
# consistent with the other static-IP nodes on this network (Traefik
# itself, tailscale-admin, traefik-private-forwarder), even though what
# actually matters for the tailnet-DNS-server registration is the
# Tailscale-assigned 100.x.x.x address, not this Docker-internal one. Must
# be a free address within traefik-proxy's subnet (confirmed live:
# 172.27.0.0/16), distinct from TRAEFIK_INTERNAL_IP (172.27.255.250) and
# TAILSCALE_ADMIN_INTERNAL_IP (172.27.255.249).
TAILSCALE_ADGUARD_INTERNAL_IP=172.27.255.248

# adguard's own static IP on traefik-proxy (set in ../adguard/.env.example
# as ADGUARD_INTERNAL_IP) - the dnsdist canary's backend target. Must match
# that value exactly; the dnsdist YAML config resolves this address ONCE
# at startup, unlike socat which re-resolved the `adguard` hostname on
# every connection - see ../adguard/INCIDENT-2026-09-08-dns-relay-outage.md.
ADGUARD_INTERNAL_IP=172.27.255.247
