# User IDs
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Plex claim token (get from https://www.plex.tv/claim/ — valid for 4 minutes)
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker-data

# Traefik router subdomain (family + guest tiers)
PLEX_SUBDOMAIN=plex

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_4=friends
TRAEFIK_ENTRYPOINT_3=private

# Host port for direct LAN-IP access (bypasses Traefik/Cloudflare)
PLEX_HOST_PORT=32400
