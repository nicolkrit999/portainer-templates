# mini-qr has no NAS paths, TZ, or user directives — no env vars required

# Traefik router subdomain (private tier, pending family confirmation)
MINI_QR_SUBDOMAIN=miniqr

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_3=private
