apiVersion: 1

# Grafana's alerting-provisioning env-var interpolation is broken/unsupported
# in this deployed image (grafana/grafana-enterprise:13.2.1) - all three
# documented syntaxes (${VAR}/secureSettings/$VAR) fail identically with
# "could not find webhook url property in settings" at startup. Matches
# unresolved upstream issues grafana/grafana#54984 and #56437. Workaround:
# this file is a TEMPLATE (kept out of Grafana's provisioning glob via the
# .template extension) rendered into the real contactpoints.yml by the
# grafana-init container at startup via a plain sed substitution - see
# grafana/docker-compose.yml's grafana-init command.
contactPoints:
  - orgId: 1
    name: discord-alerts
    receivers:
      - uid: discord-alerts-webhook
        type: discord
        settings:
          url: "__DISCORD_ALERT_WEBHOOK_URL__"
          use_discord_username: false
          message: |-
            {{ if eq .Status "firing" }}:rotating_light:{{ else }}:white_check_mark:{{ end }} **{{ .Status | toUpper }}** - {{ .CommonLabels.alertname }}
            {{ range .Alerts }}
            > {{ .Annotations.summary }}
            {{ end }}
        disableResolveMessage: false

policies:
  - orgId: 1
    receiver: discord-alerts
    group_by:
      - grafana_folder
      - alertname
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
