TZ=Europe/Zurich

# Fast/SSD-class storage root for this service's config + provisioning dirs
VOLUME_CONFIG=/volume2/docker

# Default admin username (used for GF_SECURITY_ADMIN_USER)
ADMIN_USER=admin

# Real secret - never leave as the fake placeholder below in production
GRAFANA_ADMIN_PASSWORD=changeme-strong-password

# Traefik private-tier + tailnet-admin router hostname segment (grafana.${DOMAIN})
GRAFANA_SUBDOMAIN=grafana

# Real secret - Discord webhook URL for Grafana's provisioned "discord-alerts"
# contact point (grafana/provisioning/alerting/contactpoints.yml). Never
# leave a real webhook URL in this file - fake placeholder shown below.
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/fake-webhook-token-placeholder

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
