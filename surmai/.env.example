DOCKER_DATA_DIR=/opt/docker-data

# Surmai admin account
SURMAI_ADMIN_EMAIL=admin@example.com
SURMAI_ADMIN_PASSWORD=your-password-here

# Traefik routing
SURMAI_SUBDOMAIN=viaggi

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_4=friends
TRAEFIK_ENTRYPOINT_3=private
