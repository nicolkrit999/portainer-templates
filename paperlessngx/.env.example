# User IDs
PUID=1000
PGID=1000

# Timezone
TZ=Europe/Zurich

# Admin user
ADMIN_USER=admin

# Hostname segment; the public URL, allowed hosts and Traefik routers use <PAPERLESS_SUBDOMAIN>.<DOMAIN>
PAPERLESS_SUBDOMAIN=paperlessngx

# OPTIONAL (compose default is the value below). Subnet of the internal-only backend network (db, redis, tika,
# gotenberg, web); must not overlap any other Docker network
PAPERLESS_BACKEND_SUBNET=172.16.90.16/28

# Container hostnames
PAPERLESS_REDIS_HOSTNAME=paperlessngx-redis.example.com
PAPERLESS_DB_HOSTNAME=paperlessngx-db.example.com
PAPERLESS_GOTENBERG_HOSTNAME=paperlessngx-gotenberg.example.com
PAPERLESS_TIKA_HOSTNAME=paperlessngx-tika.example.com
PAPERLESS_APP_HOSTNAME=paperlessngx.example.com

# Secrets
PAPERLESS_REDIS_PASSWORD=your-redis-password-here
# POSTGRES_PASSWORD (database container) and PAPERLESS_DBPASS (app) are ONE credential: set both to the same value
POSTGRES_PASSWORD=your-db-password-here
PAPERLESS_DBPASS=your-db-password-here
# Only used to create the first superuser; ignored once any superuser exists
PAPERLESS_ADMIN_PASSWORD=your-admin-password-here
PAPERLESS_SECRET_KEY=your-paperless-secret-key-here

# Volume base paths
DOCKER_DATA_DIR=/opt/docker-data

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
