DOCKER_CONFIG_DIR=/opt/docker
TZ=Europe/Zurich
TUGTAINER_SUBDOMAIN=tugtainer

# REQUIRED. Shared secret between the app and its internal agent process (it refuses unsigned
# requests without it). Generate with: openssl rand -hex 32
TUGTAINER_AGENT_SECRET=change-me-64-char-hex-secret

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
