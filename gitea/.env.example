# User IDs
PUID=1000
PGID=1000

# Gitea public URLs (note: timezone is set via host volume mounts, not TZ env var)
GITEA_ROOT_URL=https://gitea.example.com/
GITEA_DOMAIN=gitea.example.com

# Volume base paths
DOCKER_DATA_DIR=/opt/docker-data

# OPTIONAL (default shown). Proxies whose X-Forwarded-For Gitea trusts (REVERSE_PROXY_TRUSTED_PROXIES): the
# traefik-proxy network subnet (private Traefik) and the public-gitea backend
# network subnet (traefik-public). Comma-separated IPs/CIDRs.
GITEA_TRUSTED_PROXIES=172.27.0.0/16,172.16.81.0/28

# Traefik reverse-proxy hostname (subdomain segment only, combined with ${DOMAIN})
GITEA_SUBDOMAIN=gitea

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# OPTIONAL (default 2222). Host port for private Git over SSH (the NAS's own sshd keeps 22);
# reached at gitea-ssh.${DOMAIN}, clients need `Port 2222` in their ssh config
GITEA_SSH_HOST_PORT=2222
