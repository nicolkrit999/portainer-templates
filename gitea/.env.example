# User IDs
PUID=1000
PGID=1000

# Gitea public URLs (note: timezone is set via host volume mounts, not TZ env var)
GITEA_ROOT_URL=https://gitea.example.com/
GITEA_DOMAIN=gitea.example.com
GITEA_SSH_DOMAIN=gitea-ssh.example.com

# Volume base paths
DOCKER_DATA_DIR=/opt/docker-data

# Host port
GITEA_HOST_PORT=3000

# Traefik reverse-proxy hostname (subdomain segment only, combined with ${DOMAIN})
GITEA_SUBDOMAIN=gitea

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
