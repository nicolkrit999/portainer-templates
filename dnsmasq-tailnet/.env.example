# Not consumed by the dnsmasq image itself (this image has no TZ support -
# verified against its Dockerfile, which is plain Alpine with no tzdata
# package). Kept here only for repo-wide consistency with other services'
# .env files; safe to leave unset.
TZ=Europe/Zurich

# Wildcard domain this dnsmasq stopgap answers for. All subdomains of this
# domain resolve to TAILNET_IP below via dnsmasq's --address=/domain/ip
# syntax, which natively covers the domain and every subdomain. Should
# match the DNS_WILDCARD_DOMAIN value used in the sibling ../dnsmasq/.env.
DNS_WILDCARD_DOMAIN=example.com

# The NAS's own Tailscale IP (its tailscale0 interface address) - NOT a LAN
# IP. Find it with `tailscale status` on the NAS, or in the Tailscale admin
# console under this machine's entry. Typically in the 100.64.0.0/10 CGNAT
# range Tailscale uses for tailnet addresses.
#
# This is a clearly-marked placeholder below (100.x.y.z) - replace with the
# real value before deploying.
TAILNET_IP=100.x.y.z
