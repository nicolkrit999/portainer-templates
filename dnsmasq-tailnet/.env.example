# Wildcard domain this dnsmasq answers for. The domain and every subdomain
# resolve to TAILSCALE_ADMIN_IP below via dnsmasq's --address=/domain/ip
# syntax. Should match the DNS_WILDCARD_DOMAIN value used in the sibling
# ../dnsmasq/.env.
DNS_WILDCARD_DOMAIN=example.com

# The NAS's own Tailscale IP (its tailscale0 interface address) - NOT a LAN
# IP. Find it with `tailscale status` on the NAS, or in the Tailscale admin
# console under this machine's entry. Only used for the single non-HTTP
# override gitea-ssh.${DNS_WILDCARD_DOMAIN} (Git over SSH is published on the
# NAS itself, host port 2222, and never goes through Traefik).
#
# This is a clearly-marked placeholder below (100.x.y.z) - replace with the
# real value before deploying.
TAILNET_IP=100.x.y.z

# The tailscale-admin gateway's OWN tailnet IP (its tailscale0 interface
# address on the second Tailscale node, part of
# ../tailscale-admin_traefik-tailnet-forwarder/) - NOT a LAN IP, and NOT the
# same thing as TAILSCALE_ADMIN_INTERNAL_IP used elsewhere in this repo (that's
# a Docker-internal address, e.g. 172.27.255.249, used for the traefik-proxy
# network trust boundary). Find this value with `tailscale status` on/for the
# tailscale-admin node, or in the Tailscale admin console under that node's
# entry. Typically in the 100.64.0.0/10 CGNAT range.
#
# Every name under DNS_WILDCARD_DOMAIN resolves here, so every service is reached
# through the gateway and the tailnet-admin Traefik entrypoint.
#
# This is a clearly-marked placeholder below (100.x.y.z) - replace with the
# real value before deploying.
TAILSCALE_ADMIN_IP=100.x.y.z
