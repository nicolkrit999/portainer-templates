# Database credentials (applied only when the MySQL data directory is first created)
MYSQL_ROOT_PASSWORD=your-root-password-here
MYSQL_DATABASE=easyappointments
MYSQL_USER=eauser
MYSQL_PASSWORD=your-db-password-here

TZ=Europe/London

# phpMyAdmin upload limit
PMA_UPLOAD_LIMIT=64M

# Base path of the Docker config pool. The Easy!Appointments release lives in
# ${DOCKER_CONFIG_DIR}/easyappointments-app (see README.md); MySQL data lives
# in ${DOCKER_CONFIG_DIR}/easyappointments-mysql (must exist before the deploy,
# the compose file refuses to create it).
DOCKER_CONFIG_DIR=/opt/docker

# OPTIONAL (default shown). Proxies whose X-Forwarded-For Easy!Appointments trusts (PROXY_IPS, needs 1.6.x):
# the public-easy-appointments network (traefik-public) and the traefik-proxy
# network (private Traefik). Comma-separated IPs/CIDRs.
EASY_APPOINTMENTS_PROXY_IPS=172.16.88.0/28,172.27.0.0/16

# OPTIONAL (default shown). Subnet of the stack-internal easy-appointments-backend network (nginx,
# php-fpm, MySQL, phpMyAdmin). Must not overlap any other Docker network or the LAN.
EASY_APPOINTMENTS_BACKEND_SUBNET=172.16.88.16/28

# Traefik reverse-proxy hostnames (booking site, then the private-only sub-services)
EASY_APPOINTMENTS_SUBDOMAIN=appuntamenti
EASY_APPOINTMENTS_PMA_SUBDOMAIN=appuntamenti-pma
EASY_APPOINTMENTS_SWAGGER_SUBDOMAIN=appuntamenti-swagger

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
