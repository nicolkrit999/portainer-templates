TZ=Europe/Zurich

# Volume base paths (fast/SSD-class config storage vs bulk data storage)
VOLUME_CONFIG=/opt/docker
VOLUME_DATA=/opt/docker-data

AFFINE_EXTERNAL_URL=https://affine.example.com
AFFINE_ADMIN_EMAIL=krit@example.com
AFFINE_ADMIN_PASSWORD=change-me-strong-password
AFFINE_DB_USER=affine
AFFINE_DB_PASSWORD=change-me-db-password
AFFINE_DB_NAME=affine
AFFINE_MAILER_USER=you@gmail.com
AFFINE_MAILER_PASSWORD=xxxx-xxxx-xxxx-xxxx
AFFINE_SUBDOMAIN=affine

# Postgres connection URL; host is the compose service name `postgres`, user/password/db must match the AFFINE_DB_* values above
AFFINE_DATABASE_URL=postgres://affine:your-password-here@postgres:5432/affine

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# OPTIONAL (defaults shown). The internal affine-backend network (database, cache, migration);
# the subnet must not overlap any other Docker network, the LAN or the tailnet.
AFFINE_BACKEND_SUBNET=172.16.108.0/28
AFFINE_BACKEND_GATEWAY=172.16.108.1
AFFINE_BACKEND_IP_RANGE=172.16.108.8/29
