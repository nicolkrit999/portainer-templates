TZ=Europe/Zurich
AFFINE_EXTERNAL_URL=https://affine.nicolkrit.ch
AFFINE_ADMIN_EMAIL=krit@example.com
AFFINE_ADMIN_PASSWORD=change-me-strong-password
AFFINE_DB_USER=affine
AFFINE_DB_PASSWORD=change-me-db-password
AFFINE_DB_NAME=affine
AFFINE_MAILER_USER=you@gmail.com
AFFINE_MAILER_PASSWORD=xxxx-xxxx-xxxx-xxxx
AFFINE_SUBDOMAIN=affine

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
AFFINE_DATABASE_URL=postgres://affine:your-password-here@affine-db:5432/affine

# --- SAN-bundle cert group ("productivity-creative", anchor: affine) ---
# These vars mirror the *other* 10 member services' own SUBDOMAIN defaults so
# this stack's router can list them all as SANs on its own certificate.
# Values copied exactly from each sibling's own .env.example - do not change
# independently of that service's own file, or the cert's SAN list and that
# service's real router rule will drift apart.
DRAWIO_SUBDOMAIN=draw-io
EXCALIDRAW_SUBDOMAIN=excalidraw
FOSSFLOW_SUBDOMAIN=fossflow
OPENNOTEBOOK_SUBDOMAIN=opennotebook
PAPERLESS_SUBDOMAIN=paperlessngx
LINKWARDEN_SUBDOMAIN=linkwarden
HOLYCLAUDE_SUBDOMAIN=claude
BLENDER_SUBDOMAIN=blender
LIFEGLANCE_SUBDOMAIN=lifeglance
GHOST_SUBDOMAIN=blog
TRAEFIK_ENTRYPOINT_7=tailnet-admin
