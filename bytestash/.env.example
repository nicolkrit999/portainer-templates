DOCKER_CONFIG_DIR=/opt/docker

# Timezone for the container
TZ=Europe/Zurich

# ByteStash secrets
# Long random string (at least 32 characters) used to sign login tokens
JWT_SECRET=your-jwt-secret-here

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
BYTESTASH_SUBDOMAIN=bytestash
TRAEFIK_ENTRYPOINT_7=tailnet-admin
