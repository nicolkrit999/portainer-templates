TZ=Etc/UTC

# UniFi OS controller's HTTPS URL (Dream Machine/Cloud Key/self-hosted
# controller), e.g. https://192.168.1.1 or https://unifi.example.com:8443
UNIFI_CONTROLLER_URL=https://192.168.1.1

# Must be a local, READ-ONLY UniFi API user - create it manually in the
# UniFi console (Settings > Admins > Add Admin > Restrict to Local Access
# Only, role "Read Only") before this can poll anything. Do not reuse your
# main admin account.
UNIFI_POLLER_USER=unpoller-readonly

UNIFI_POLLER_PASSWORD=change-me
