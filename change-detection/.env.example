DOCKER_CONFIG_DIR=/opt/docker
TZ=Europe/London

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
CHANGE_DETECTION_SUBDOMAIN=change-detection
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# change-detection-backend network (stack-private); override only on a subnet collision
CHANGE_DETECTION_BACKEND_SUBNET=172.16.99.0/28
CHANGE_DETECTION_BACKEND_GATEWAY=172.16.99.1
CHANGE_DETECTION_BACKEND_IP_RANGE=172.16.99.8/29
