# User IDs
PUID=1000
PGID=1000

# Immich version tag (leave empty to use "release")
IMMICH_VERSION=

# Database credentials
DB_PASSWORD=your-db-password-here

# Storage paths
UPLOAD_LOCATION=/opt/docker-data/immich/uploads
DB_DATA_LOCATION=/opt/docker-data/immich/postgres

# Public server URL
PUBLIC_IMMICH_SERVER_URL=https://immich.example.com

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker-data

# Traefik router subdomain (family + guest tiers)
IMMICH_SUBDOMAIN=foto

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_4=friends
TRAEFIK_ENTRYPOINT_3=private
