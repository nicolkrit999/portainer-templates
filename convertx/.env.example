# Timezone
TZ=America/New_York

# Hostname segment for the private (LAN) and tailnet routers (https://convertx.${DOMAIN})
CONVERTX_SUBDOMAIN=convertx

# JWT secret (random 32+ character string)
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Volume base paths
DOCKER_DATA_DIR=/opt/docker-data

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# Host port for direct LAN-IP access (bypasses Traefik)
CONVERTX_HOST_PORT=3010
