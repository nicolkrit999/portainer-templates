# Timezone
TZ=Europe/Zurich

# Password of the Actual Budget server (the login you use in the web UI)
ACTUAL_PASSWORD=change-me

# Sync ID of the budget: Actual > Settings > Show advanced settings > Sync ID
ACTUAL_BUDGET_ID_1=00000000-0000-0000-0000-000000000000

# Label shown on the metrics for this budget
ACTUAL_BUDGET_NAME_1=budget-1

# Second budget (same Actual server and password): its Sync ID and a distinct label
ACTUAL_BUDGET_ID_2=00000000-0000-0000-0000-000000000000
ACTUAL_BUDGET_NAME_2=budget-2
