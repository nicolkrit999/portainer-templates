# Timezone
TZ=America/New_York

# Base domain (routers are host-matched as <service>.DOMAIN)
DOMAIN=example.com

# Volume base path (fast/SSD-class config storage)
VOLUME_CONFIG=/volume2/docker

# Cloudflare DNS API token with Zone:DNS:Edit permission (used for the ACME DNS-01 challenge)
CF_DNS_API_TOKEN=your-cloudflare-dns-edit-token

# Email address registered with Let's Encrypt for certificate notices
ACME_EMAIL=you@example.com

# Pre-generated htpasswd string (user:apr1-hash) for the Traefik dashboard basic auth
TRAEFIK_DASHBOARD_HTPASSWD=admin:$apr1$replace$with$real$hash

# NAS's existing LAN IP (used to explicitly scope the family-tier port publish,
# required once a second host IP exists for the private tier - an unscoped
# wildcard publish on the same port number would otherwise conflict with it)
NAS_IP=192.168.1.98

# Second static IP on the NAS, dedicated to the private tier, so it's reachable
# on standard port 443 with no port number needed in the URL. This IP must
# already exist as a real secondary address on the NAS's own network interface
# (OS-level config, outside Docker/compose - not something this file sets up).
TRAEFIK_PRIVATE_IP=192.168.1.99
