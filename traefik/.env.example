# Timezone
TZ=America/New_York

# Base domain (routers are host-matched as <service>.DOMAIN)
DOMAIN=example.com

# Volume base path (fast/SSD-class config storage)
VOLUME_CONFIG=/volume2/docker

# Cloudflare DNS API token with Zone:DNS:Edit permission (used for the ACME DNS-01 challenge)
CF_DNS_API_TOKEN=your-cloudflare-dns-edit-token

# Email address registered with Let's Encrypt for certificate notices
ACME_EMAIL=you@example.com

# Pre-generated htpasswd string (user:apr1-hash) for the Traefik dashboard basic auth
TRAEFIK_DASHBOARD_HTPASSWD=admin:$apr1$replace$with$real$hash

# Traefik entrypoint names and ports (generic numbering - values are what actually
# determine the tier; comment documents this instance's chosen mapping)
# 1 = family tier (443), 2 = guest tier (8443), 3 = private tier / asDefault
# (8444, internal-only - see the compose file's own comment for why), 4 = friends
# tier (8445), 5 = internal cloudflared-facing entrypoint (no host port),
# 6 = internal ping/dashboard-API entrypoint (no host port)
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_4=friends
TRAEFIK_ENTRYPOINT_5=cloudflared
TRAEFIK_ENTRYPOINT_6=traefik
TRAEFIK_PORT_1=443
TRAEFIK_PORT_2=8443
TRAEFIK_PORT_3=8444
TRAEFIK_PORT_4=8445
TRAEFIK_PORT_5=9080
TRAEFIK_PORT_6=8080
