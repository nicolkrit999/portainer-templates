# Timezone
TZ=America/New_York

# Base domain (routers are host-matched as <service>.DOMAIN)
DOMAIN=example.com

# Volume base path (fast/SSD-class config storage)
VOLUME_CONFIG=/volume2/docker

# Cloudflare DNS API token with Zone:DNS:Edit permission (used for the ACME DNS-01 challenge)
CF_DNS_API_TOKEN=your-cloudflare-dns-edit-token

# Email address registered with Let's Encrypt for certificate notices
ACME_EMAIL=you@example.com

# Pre-generated htpasswd string (user:apr1-hash) for the Traefik dashboard basic auth
TRAEFIK_DASHBOARD_HTPASSWD=admin:$apr1$replace$with$real$hash

# Traefik entrypoint names and ports. The numbering starts at 3 on purpose (1, 2,
# 4 and 5 were retired entrypoints), so other stacks' variables did not change.
# 3 = private (LAN path) / asDefault (8444, reached on :443 through
# traefik-private-forwarder),
# 6 = internal ping entrypoint (no host port), 7 = internal tailnet-admin
# entrypoint (no host port - reached only via the traefik-tailnet-forwarder
# sidecar, see that stack's own .env.example)
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_6=traefik
TRAEFIK_ENTRYPOINT_7=tailnet-admin
TRAEFIK_PORT_3=8444
TRAEFIK_PORT_6=8080
TRAEFIK_PORT_7=8446

# Traefik's own static IP on the traefik-proxy Docker network - required so
# the traefik-tailnet-forwarder sidecar (which shares tailscale-admin's
# network namespace, not Traefik's own, and has no DNS resolution of its
# own there) has a fixed address to target. Must be a free address within
# traefik-proxy's subnet (confirmed live: 172.27.0.0/16).
TRAEFIK_INTERNAL_IP=172.27.255.250

# Comma-separated /32 CIDRs of the owner's own known Tailscale device IPs
# (from `tailscale status`) - gates every tailnet router (entrypoint 7) via
# the shared tailnet-admin-only middleware. Do NOT use the full Tailscale
# CGNAT range (100.64.0.0/10) - that would let any future tailnet identity
# through automatically.
TAILNET_ADMIN_IPS=100.x.y.z/32,100.x.y.z/32

# Static IP of the tailscale-admin sidecar
# (../tailscale-admin_traefik-tailnet-forwarder/.env.example) on the
# traefik-proxy Docker network. Must match TAILSCALE_ADMIN_INTERNAL_IP in
# that stack's .env.example exactly - Traefik's tailnet-admin entrypoint
# trusts PROXY protocol headers only from this address (see the
# proxyProtocol.trustedIPs comment in this stack's docker-compose.yml).
TAILSCALE_ADMIN_INTERNAL_IP=172.27.255.249
