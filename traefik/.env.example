# Timezone
TZ=America/New_York

# Base domain (routers are host-matched as <service>.DOMAIN)
DOMAIN=example.com

# Volume base path (fast/SSD-class config storage)
VOLUME_CONFIG=/volume2/docker

# Cloudflare DNS API token with Zone:DNS:Edit permission (used for the ACME DNS-01 challenge)
CF_DNS_API_TOKEN=your-cloudflare-dns-edit-token

# Email address registered with Let's Encrypt for certificate notices
ACME_EMAIL=you@example.com

# Pre-generated htpasswd string (user:apr1-hash) for the Traefik dashboard basic auth
TRAEFIK_DASHBOARD_HTPASSWD=admin:$apr1$replace$with$real$hash
