# Timezone
TZ=Europe/Zurich

DOCKER_CONFIG_DIR=/opt/docker
HARBORGUARD_SUBDOMAIN=harborguard

# Public URLs
NEXT_PUBLIC_APP_URL=https://harborguard.example.com
NEXT_PUBLIC_API_URL=https://harborguard.example.com

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# OPTIONAL (the compose has these defaults): harborguard-backend network (internal, stack-private); override only on a subnet collision
HARBORGUARD_BACKEND_SUBNET=172.16.102.0/28
HARBORGUARD_BACKEND_GATEWAY=172.16.102.1
HARBORGUARD_BACKEND_IP_RANGE=172.16.102.8/29
