DOCKER_DATA_DIR=/opt/docker-data
TZ=Europe/London
PUID=1000
PGID=1000

# Traefik private-tier router hostname segment (gotify.${DOMAIN})
GOTIFY_SUBDOMAIN=gotify

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# gotify-notify network (shared with the watchtower stack, which joins it as external; deploy gotify first); override only on a subnet collision
GOTIFY_NOTIFY_SUBNET=172.16.101.0/28
GOTIFY_NOTIFY_GATEWAY=172.16.101.1
GOTIFY_NOTIFY_IP_RANGE=172.16.101.8/29
