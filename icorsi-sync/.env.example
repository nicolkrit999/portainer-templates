# Timezone
TZ=America/New_York

# Host user the container drops to (must own the mounted /data dir)
PUID=1000
PGID=1000

# Moodle/iCorsi credentials
# ICORSI_TOKEN + ICORSI_PRIVATETOKEN + ICORSI_USERID seed /data/token.json on first
# start, after which the tool re-mints the token headlessly. KEEP THESE SET: they are
# the only recovery path if token.json is ever lost/corrupted or the token fully lapses
# (container offline > ~2 days across an expiry). Capture all three once via the
# launch.php incognito flow (see README).
ICORSI_TOKEN=your-moodle-webservice-token-here
ICORSI_PRIVATETOKEN=your-moodle-privatetoken-here
ICORSI_USERID=your-moodle-userid-here

# Fallback for the rare case you truly can't get a privatetoken from launch.php even doing the
# capture in the correct order (logged-out-first - see README). Set this INSTEAD of
# ICORSI_PRIVATETOKEN: capture the session cookie value (named "MoodleSession", sometimes
# suffixed per-install e.g. "MoodleSessionelabm2") from DevTools -> Application -> Cookies after
# logging in (see README). Format: "<cookie name>=<value>" (or just "<value>", MoodleSession is
# assumed).
ICORSI_SESSION_COOKIE=

# OpenCloud WebDAV connection
OPENCLOUD_USER=your-opencloud-username
OPENCLOUD_APP_PASSWORD=your-opencloud-app-password
# Spaces-based WebDAV: https://<host>/dav/spaces/<space-id>, where <space-id> is
# "<storage-uuid>$<node-uuid>" (the "$" does not need percent-encoding for most
# clients). OpenCloud's web UI only shows a WebDAV link scoped to whatever folder
# you're currently browsing (Files -> a folder -> Details) - drop everything after
# the space id itself to get the space's ROOT url (full contents, not one
# subfolder). The space id is also the container's data dir name under
# storage/users/projects/<node-uuid>.
OPENCLOUD_WEBDAV_URL=http://opencloud:9200/dav/spaces/your-storage-uuid$your-node-uuid
# Trusted domain to send as the HTTP Host header when hitting the container directly.
# May not be required by OpenCloud (unlike classic ownCloud) - leave blank and test
# first; only set this if direct requests to OPENCLOUD_WEBDAV_URL's host get rejected.
OPENCLOUD_HOST_HEADER=opencloud.example.com
# Base folder inside the space - courses.json paths are relative to this.
# Empty ("") if courses.json's keys are already relative to the space root.
OPENCLOUD_BASE_PATH=

# Discord webhook for sync notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-here

# Positive heartbeat: GET this URL after each successful run (optional; uptime-kuma / healthchecks.io)
HEARTBEAT_URL=

# Sync behaviour (defaults are usually fine)
SUBFOLDER=_icorsi
INCLUDE_URL_LINKS=true
SAVE_SECTION_INFO=true
SAVE_FORUMS=true
ICORSI_CONCURRENCY=4

# Excluded modules, default to "-"
EXCLUDE_MODULES=
PRUNE_ORPHANS=false
RECON_MAX_PASSES=5
SYNC_INTERVAL_SECONDS=21600
RUN_ON_START=true
DRY_RUN=false

# Volume base path. Data lives at <VOLUME_CONFIG>/icorsi-sync/data (mounted to /data).
VOLUME_CONFIG=/volume2/docker
