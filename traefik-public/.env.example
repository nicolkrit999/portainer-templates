# Every variable below except TZ and the PUBLIC_*_SUBNET / PUBLIC_*_PROXY_IP ones is required: the stack refuses to deploy if one is unset or empty.

# Timezone
TZ=Europe/Zurich

# Base domain (routers are host-matched as <subdomain>.DOMAIN)
DOMAIN=example.com

# Volume base path (fast/SSD-class config storage); holds traefik-public/acme.json and the generated dynamic config
VOLUME_CONFIG=/volume2/docker

# Email address registered with Let's Encrypt for certificate notices
ACME_EMAIL=you@example.com

# Cloudflare API token for the ACME DNS-01 challenge of this internet-facing Traefik. Create it as a dedicated
# token named traefik-public-dns01; never reuse the core Traefik's token.
# Permissions: Zone.DNS:Edit + Zone.Zone:Read on the single zone. That covers EVERY DNS record in the zone,
# so it is a high-value secret: dedicated token only, and rotate it if this host is ever suspected compromised.
CF_DNS_API_TOKEN_PUBLIC=your-cloudflare-dns-edit-token-here

# Dedicated LAN IP of this container on the existing macvlan network; the UniFi WAN TCP 443 forward targets it.
# Must be a free static IP in the LAN subnet, outside the DHCP pool and distinct from every other macvlan IP.
# Never add it to MACVLAN_ATTACHED_IPS in the macvlan-host-shim stack.
TRAEFIK_PUBLIC_IP=192.168.1.94

# Hostname segment of the test router (public-test.DOMAIN) used to verify the public path before real hostnames move over
PUBLIC_TEST_SUBDOMAIN=public-test

# Immich hostname segment of the public router; must match IMMICH_SUBDOMAIN in the immich stack's env
IMMICH_SUBDOMAIN=foto

# Pocket-ID hostname segment of the public router; must match POCKET_ID_SUBDOMAIN in the pocket-id stack's env
# and the host of Pocket-ID's APP_URL (the OIDC issuer clients use)
POCKET_ID_SUBDOMAIN=pocket-id

# Jellyfin hostname segment of the public router; must match JELLYFIN_SUBDOMAIN in the jellyfin stack's env
JELLYFIN_SUBDOMAIN=jellyfin

# Navidrome hostname segment of the public router; must match NAVIDROME_SUBDOMAIN in the navidrome stack's env
NAVIDROME_SUBDOMAIN=navidrome

# Gokapi hostname segment of the public router; must match GOKAPI_SUBDOMAIN in the gokapi stack's env
GOKAPI_SUBDOMAIN=gokapi

# Gitea hostname segment of the public router; must match GITEA_SUBDOMAIN in the gitea stack's env
# and the host of Gitea's ROOT_URL
GITEA_SUBDOMAIN=gitea

# PrivateBin hostname segment of the public router; must match PRIVATEBIN_SUBDOMAIN in the privatebin stack's env
PRIVATEBIN_SUBDOMAIN=privatebin

# Optional. Subnet of the public-pocket-id backend network (internal, three addresses are enough). Keep it outside
# Docker's default address pools (172.17.0.0/16-172.31.0.0/16, 192.168.0.0/16), your LAN/VLANs and the tailnet.
PUBLIC_POCKET_ID_SUBNET=172.16.77.0/28

# Optional. Subnets of the per-application backend networks (internal, the proxy plus one backend). Same placement
# rules as above; each must be unique among all Docker networks on the host.
PUBLIC_JELLYFIN_SUBNET=172.16.78.0/28
PUBLIC_NAVIDROME_SUBNET=172.16.79.0/28
PUBLIC_GOKAPI_SUBNET=172.16.80.0/28
PUBLIC_GITEA_SUBNET=172.16.81.0/28
PUBLIC_PRIVATEBIN_SUBNET=172.16.82.0/28

# Optional. The proxy's fixed address on each backend network above, so a backend that only accepts host addresses in
# its trusted-proxy setting (Jellyfin's Known Proxies) can name it. Must lie inside the matching subnet and must not be
# its first address (the Docker gateway); change it together with the subnet.
PUBLIC_JELLYFIN_PROXY_IP=172.16.78.2
PUBLIC_NAVIDROME_PROXY_IP=172.16.79.2
PUBLIC_GOKAPI_PROXY_IP=172.16.80.2
PUBLIC_GITEA_PROXY_IP=172.16.81.2
PUBLIC_PRIVATEBIN_PROXY_IP=172.16.82.2
