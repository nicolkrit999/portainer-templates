# Every variable below except TZ and the PUBLIC_*_SUBNET / PUBLIC_*_GATEWAY / PUBLIC_*_IP_RANGE / PUBLIC_*_PROXY_IP ones is required: the stack refuses to deploy if one is unset or empty.

# Timezone
TZ=Europe/Zurich

# Base domain (routers are host-matched as <subdomain>.DOMAIN)
DOMAIN=example.com

# Volume base path (fast/SSD-class config storage); holds traefik-public/acme.json and the generated dynamic config
VOLUME_CONFIG=/volume2/docker

# Email address registered with Let's Encrypt for certificate notices
ACME_EMAIL=you@example.com

# Cloudflare API token for the ACME DNS-01 challenge of this internet-facing Traefik. Create it as a dedicated
# token named traefik-public-dns01; never reuse the core Traefik's token.
# Permissions: Zone.DNS:Edit + Zone.Zone:Read on the single zone. That covers EVERY DNS record in the zone,
# so it is a high-value secret: dedicated token only, and rotate it if this host is ever suspected compromised.
CF_DNS_API_TOKEN_PUBLIC=your-cloudflare-dns-edit-token-here

# Dedicated LAN IP of this container on the existing macvlan network; the UniFi WAN TCP 443 forward targets it.
# Must be a free static IP in the LAN subnet, outside the DHCP pool and distinct from every other macvlan IP.
# Never add it to MACVLAN_ATTACHED_IPS in the macvlan-host-shim stack.
TRAEFIK_PUBLIC_IP=192.168.1.94

# Hostname segment of the test router (public-test.DOMAIN) used to verify the public path before real hostnames move over
PUBLIC_TEST_SUBDOMAIN=public-test

# Immich hostname segment of the public router; must match IMMICH_SUBDOMAIN in the immich stack's env
IMMICH_SUBDOMAIN=foto

# Pocket-ID hostname segment of the public router; must match POCKET_ID_SUBDOMAIN in the pocket-id stack's env
# and the host of Pocket-ID's APP_URL (the OIDC issuer clients use)
POCKET_ID_SUBDOMAIN=pocket-id

# Jellyfin hostname segment of the public router; must match JELLYFIN_SUBDOMAIN in the jellyfin stack's env
JELLYFIN_SUBDOMAIN=jellyfin

# Navidrome hostname segment of the public router; must match NAVIDROME_SUBDOMAIN in the navidrome stack's env
NAVIDROME_SUBDOMAIN=navidrome

# Gokapi hostname segment of the public router; must match GOKAPI_SUBDOMAIN in the gokapi stack's env
GOKAPI_SUBDOMAIN=gokapi

# Gitea hostname segment of the public router; must match GITEA_SUBDOMAIN in the gitea stack's env
# and the host of Gitea's ROOT_URL
GITEA_SUBDOMAIN=gitea

# PrivateBin hostname segment of the public router; must match PRIVATEBIN_SUBDOMAIN in the privatebin stack's env
PRIVATEBIN_SUBDOMAIN=privatebin

# Mealie hostname segment of the public router; must match MEALIE_SUBDOMAIN in the mealie stack's env
MEALIE_SUBDOMAIN=ricette

# Homebox hostname segment of the public router; must match HOMEBOX_SUBDOMAIN in the homebox stack's env
HOMEBOX_SUBDOMAIN=homebox

# Kavita hostname segment of the public router; must match KAVITA_SUBDOMAIN in the kavita stack's env
KAVITA_SUBDOMAIN=kavita

# OpenCloud hostname segment of the public router; must match OPENCLOUD_SUBDOMAIN in the opencloud stack's env
# and the host of OpenCloud's OC_URL
OPENCLOUD_SUBDOMAIN=opencloud

# Hi.Events hostname segment of the public router; must match HI_EVENTS_SUBDOMAIN in the hi-events stack's env
HI_EVENTS_SUBDOMAIN=eventi

# Easy!Appointments hostname segment of the public router; must match EASY_APPOINTMENTS_SUBDOMAIN in the
# easy-appointments stack's env (its nginx only answers requests for this exact host)
EASY_APPOINTMENTS_SUBDOMAIN=appuntamenti

# TREK hostname segment of the public router; must match TREK_SUBDOMAIN in the trek stack's env
TREK_SUBDOMAIN=trek

# Paperless-ngx hostname segment of the public router; must match PAPERLESS_SUBDOMAIN in the paperlessngx stack's env
# and the host of its PAPERLESS_URL
PAPERLESS_SUBDOMAIN=paperlessngx

# Linkwarden hostname segment of the public router; must match LINKWARDEN_SUBDOMAIN in the linkwarden stack's env
# and the host of its NEXTAUTH_URL
LINKWARDEN_SUBDOMAIN=linkwarden

# Actual Budget server hostname segment of the public router; must match ACTUAL_BUDGET_SUBDOMAIN in the actual-budget
# server stack's env
ACTUAL_BUDGET_SUBDOMAIN=budget

# ActualAPI hostname segment of the public router; must match ACTUAL_API_SUBDOMAIN in the actual-budget server stack's env
ACTUAL_API_SUBDOMAIN=budget-api

# actualtap hostname segment of the public router; must match ACTUAL_TAP_SUBDOMAIN in the actual-tap stack's env
ACTUAL_TAP_SUBDOMAIN=budget-tap

# ByteStash hostname segment of the public router (public snippets only); must match BYTESTASH_SUBDOMAIN in the bytestash stack's env
BYTESTASH_SUBDOMAIN=bytestash

# Optional. Subnet of the public-pocket-id backend network (internal, three addresses are enough). Keep it outside
# Docker's default address pools (172.17.0.0/16-172.31.0.0/16, 192.168.0.0/16), your LAN/VLANs and the tailnet.
PUBLIC_POCKET_ID_SUBNET=172.16.77.0/28

# Optional. Subnets of the per-application backend networks (internal, the proxy plus one backend). Same placement
# rules as above; each must be unique among all Docker networks on the host.
PUBLIC_JELLYFIN_SUBNET=172.16.78.0/28
PUBLIC_NAVIDROME_SUBNET=172.16.79.0/28
PUBLIC_GOKAPI_SUBNET=172.16.80.0/28
PUBLIC_GITEA_SUBNET=172.16.81.0/28
PUBLIC_PRIVATEBIN_SUBNET=172.16.82.0/28

# Optional. Subnets of the Mealie, Homebox, Kavita, OpenCloud, Hi.Events, Easy!Appointments and TREK backend networks
# (internal, the proxy plus one backend). Same placement rules as above; each must be unique among all Docker networks
# on the host.
PUBLIC_MEALIE_SUBNET=172.16.83.0/28
PUBLIC_HOMEBOX_SUBNET=172.16.84.0/28
PUBLIC_KAVITA_SUBNET=172.16.85.0/28
PUBLIC_OPENCLOUD_SUBNET=172.16.86.0/28
PUBLIC_HI_EVENTS_SUBNET=172.16.87.0/28
PUBLIC_EASY_APPOINTMENTS_SUBNET=172.16.88.0/28
PUBLIC_TREK_SUBNET=172.16.89.0/28

# Optional. Subnets of the Paperless-ngx, Linkwarden, Actual Budget, ActualAPI and actualtap backend networks (internal,
# the proxy plus one backend). Same placement rules as above; each must be unique among all Docker networks on the host.
PUBLIC_PAPERLESS_SUBNET=172.16.90.0/28
PUBLIC_LINKWARDEN_SUBNET=172.16.91.0/28
PUBLIC_BUDGET_SUBNET=172.16.93.0/28
PUBLIC_BUDGET_API_SUBNET=172.16.94.0/28
PUBLIC_BUDGET_TAP_SUBNET=172.16.95.0/28
PUBLIC_BYTESTASH_SUBNET=172.16.92.0/28

# Optional. Gateway of each of those networks: the subnet's first address. Set it explicitly together with the
# ip_range below, otherwise Docker takes the first address of the ip_range as the gateway.
PUBLIC_MEALIE_GATEWAY=172.16.83.1
PUBLIC_HOMEBOX_GATEWAY=172.16.84.1
PUBLIC_KAVITA_GATEWAY=172.16.85.1
PUBLIC_OPENCLOUD_GATEWAY=172.16.86.1
PUBLIC_HI_EVENTS_GATEWAY=172.16.87.1
PUBLIC_EASY_APPOINTMENTS_GATEWAY=172.16.88.1
PUBLIC_TREK_GATEWAY=172.16.89.1
PUBLIC_PAPERLESS_GATEWAY=172.16.90.1
PUBLIC_LINKWARDEN_GATEWAY=172.16.91.1
PUBLIC_BUDGET_GATEWAY=172.16.93.1
PUBLIC_BUDGET_API_GATEWAY=172.16.94.1
PUBLIC_BUDGET_TAP_GATEWAY=172.16.95.1
PUBLIC_BYTESTASH_GATEWAY=172.16.92.1

# Optional. Range Docker hands out backend addresses from, the upper half of each subnet. Must lie inside the subnet and
# must not contain the proxy's fixed address below, so a backend can never take that address before the proxy attaches.
PUBLIC_MEALIE_IP_RANGE=172.16.83.8/29
PUBLIC_HOMEBOX_IP_RANGE=172.16.84.8/29
PUBLIC_KAVITA_IP_RANGE=172.16.85.8/29
PUBLIC_OPENCLOUD_IP_RANGE=172.16.86.8/29
PUBLIC_HI_EVENTS_IP_RANGE=172.16.87.8/29
PUBLIC_EASY_APPOINTMENTS_IP_RANGE=172.16.88.8/29
PUBLIC_TREK_IP_RANGE=172.16.89.8/29
PUBLIC_PAPERLESS_IP_RANGE=172.16.90.8/29
PUBLIC_LINKWARDEN_IP_RANGE=172.16.91.8/29
PUBLIC_BUDGET_IP_RANGE=172.16.93.8/29
PUBLIC_BUDGET_API_IP_RANGE=172.16.94.8/29
PUBLIC_BUDGET_TAP_IP_RANGE=172.16.95.8/29
PUBLIC_BYTESTASH_IP_RANGE=172.16.92.8/29

# Optional. The proxy's fixed address on each backend network above, so a backend that only accepts host addresses in
# its trusted-proxy setting (Jellyfin's Known Proxies) can name it. Must lie inside the matching subnet and must not be
# its first address (the Docker gateway); on the networks that have an ip_range it must also lie outside that range.
# Change it together with the subnet.
PUBLIC_JELLYFIN_PROXY_IP=172.16.78.2
PUBLIC_NAVIDROME_PROXY_IP=172.16.79.2
PUBLIC_GOKAPI_PROXY_IP=172.16.80.2
PUBLIC_GITEA_PROXY_IP=172.16.81.2
PUBLIC_PRIVATEBIN_PROXY_IP=172.16.82.2
PUBLIC_MEALIE_PROXY_IP=172.16.83.2
PUBLIC_HOMEBOX_PROXY_IP=172.16.84.2
PUBLIC_KAVITA_PROXY_IP=172.16.85.2
PUBLIC_OPENCLOUD_PROXY_IP=172.16.86.2
PUBLIC_HI_EVENTS_PROXY_IP=172.16.87.2
PUBLIC_EASY_APPOINTMENTS_PROXY_IP=172.16.88.2
PUBLIC_TREK_PROXY_IP=172.16.89.2
PUBLIC_PAPERLESS_PROXY_IP=172.16.90.2
PUBLIC_LINKWARDEN_PROXY_IP=172.16.91.2
PUBLIC_BUDGET_PROXY_IP=172.16.93.2
PUBLIC_BUDGET_API_PROXY_IP=172.16.94.2
PUBLIC_BUDGET_TAP_PROXY_IP=172.16.95.2
PUBLIC_BYTESTASH_PROXY_IP=172.16.92.2
