DOCKER_CONFIG_DIR=/opt/docker
BESZEL_SUBDOMAIN=beszel

# Beszel agent secrets
BESZEL_AGENT_TOKEN=your-agent-token-here
BESZEL_AGENT_KEY=ssh-ed25519 your-public-key-here
BESZEL_HUB_URL=ws://Beszel:8090

# Beszel filesystem device to monitor
BESZEL_FILESYSTEM=/dev/sda1

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
