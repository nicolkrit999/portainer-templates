# Static IP for AdGuard on the LAN (macvlan)
ADGUARD_STATIC_IP=192.168.1.96

# Static IP for AdGuard on the traefik-proxy Docker network (172.27.0.0/16
# pool) - required so dnsdist (tailscale-adguard/docker-compose.yml's
# dns-relay-canary/dns-relay) can target a stable backend address instead
# of a hostname it only resolves once at startup. Same pool already used
# by traefik (.250), tailscale-admin (.249), tailscale-adguard (.248).
ADGUARD_INTERNAL_IP=172.27.255.247

# Volume base paths (fast/SSD-class config, bulk/HDD-class data)
VOLUME_CONFIG=/volume2/docker
VOLUME_DATA=/volume1/Default-volume-1/0001_Docker

# Traefik private-tier router hostname segment (adguard.${DOMAIN})
ADGUARD_SUBDOMAIN=adguard

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
