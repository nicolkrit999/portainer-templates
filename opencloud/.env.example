# OpenCloud app settings
# OPTIONAL (compose default: opencloud). Hostname segment: <OPENCLOUD_SUBDOMAIN>.<DOMAIN>
OPENCLOUD_SUBDOMAIN=opencloud
# Boot-time-only admin password - OpenCloud ignores this once IDM config already
# exists on disk, and the admin username is always "admin" (not configurable).
OPENCLOUD_ADMIN_PASSWORD=change-me

# HTTP basic auth (real account password) on every endpoint. Upstream documents
# it as tests/development only. The desktop and mobile apps log in via OIDC
# against the built-in IdP and do not need it; WebDAV clients that cannot do
# OIDC (rclone, davfs2) can use per-user app tokens as the password instead.
# Set to true only while a client still depends on the real password.
# OPTIONAL (compose default: false).
OPENCLOUD_ENABLE_BASIC_AUTH=false

# OPTIONAL (compose default: 172.16.86.2).
# Address of the public Traefik (traefik-public) on the public-opencloud network. The container
# resolves its own public hostname to it (extra_hosts) for server-side OIDC token verification.
# Must equal PUBLIC_OPENCLOUD_PROXY_IP in the traefik-public stack (default 172.16.86.2).
PUBLIC_OPENCLOUD_PROXY_IP=172.16.86.2

# Container UID:GID (see repo PUID/PGID convention)
PUID=1000
PGID=10

# OPTIONAL (compose defaults: opencloudeu/opencloud-rolling and 8.0.1).
# Image pinning. 8.0.1 is the version in use; 9.0.0 changes the thumbnail and
# guest-link services, so move to it deliberately, with a backup of the config
# and data directories first:
# https://docs.opencloud.eu/docs/next/admin/maintenance/upgrade/upgrade-9.x.x
OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=8.0.1

# OPTIONAL (compose default: info). Log verbosity (trace|debug|info|warn|error)
LOG_LEVEL=info

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker-data

# SMTP (Gmail relay via an app password - https://myaccount.google.com/apppasswords)
# SMTP_HOST and SMTP_PORT are OPTIONAL (compose defaults: smtp.gmail.com and 587).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=OpenCloud <your-address@gmail.com>
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=change-me

# Shared repo-wide vars
TZ=Europe/Zurich
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
