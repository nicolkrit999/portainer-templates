# OpenCloud app settings
OPENCLOUD_SUBDOMAIN=opencloud
# Boot-time-only admin password - OpenCloud ignores this once IDM config already
# exists on disk, and the admin username is always "admin" (not configurable).
OPENCLOUD_ADMIN_PASSWORD=change-me

# Container UID:GID (see repo PUID/PGID convention)
PUID=1000
PGID=10

# Image pinning
OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=8.0.1

# Log verbosity (trace|debug|info|warn|error)
LOG_LEVEL=info

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker-data

# NAS's own LAN IP - used to point this container's DNS resolution at the
# LAN dnsmasq (which already has a private-tier override for this hostname),
# so opencloud's own self-referencing OIDC discovery call stays internal
# instead of resolving over the public internet and hitting Cloudflare.
NAS_IP=192.168.1.98

# Shared repo-wide vars
TZ=Europe/Zurich
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
