# it-tools has no NAS paths, TZ, or user directives - no env vars required
IT_TOOLS_SUBDOMAIN=it-tools

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private

# --- SAN-bundle cert group ("utilities", anchor: it-tools) ---
# These vars mirror the *other* 19 member services' own SUBDOMAIN defaults so
# this stack's router can list them all as SANs on its own certificate.
# Values copied exactly from each sibling's own .env.example - do not change
# independently of that service's own file, or the cert's SAN list and that
# service's real router rule will drift apart.
OMNI_TOOLS_SUBDOMAIN=omnitools
CONVERTX_SUBDOMAIN=convertx
STIRLING_PDF_SUBDOMAIN=stirling-pdf
CHANGE_DETECTION_SUBDOMAIN=change-detection
FILEBROWSER_SUBDOMAIN=filebrowser
DUPLICATI_SUBDOMAIN=duplicati
SNAPOTTER_SUBDOMAIN=snapotter
MOOCUP_SUBDOMAIN=moocup
WITHOUTBG_SUBDOMAIN=withoutbg
CARDYO_SUBDOMAIN=cardyo
DATETIME_SUBDOMAIN=datetime
TERMIX_SUBDOMAIN=termix
SNAPPYEMAIL_SUBDOMAIN=snappyemail
OWNCLOUD_SUBDOMAIN=owncloud
MINI_QR_SUBDOMAIN=miniqr
PRIVATEBIN_SUBDOMAIN=privatebin
BYTESTASH_SUBDOMAIN=bytestash
OPENRESUME_SUBDOMAIN=openresume
SOSSE_SUBDOMAIN=sosse
TRAEFIK_ENTRYPOINT_7=tailnet-admin
