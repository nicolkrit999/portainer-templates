# Volume base paths (note: user is "0:0" intentionally for full filesystem access)
DOCKER_CONFIG_DIR=/opt/docker

# Hostname segment for the private (LAN) and tailnet routers (filebrowser.${DOMAIN})
FILEBROWSER_SUBDOMAIN=filebrowser

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# Host port for direct LAN-IP access (bypasses Traefik)
FILEBROWSER_HOST_PORT=8082
