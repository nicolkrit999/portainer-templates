DOCKER_DATA_DIR=/opt/docker-data
TZ=Europe/London
PUID=1000
PGID=1000

# Traefik router hostname segment (legacy Cloudflare override: mealie -> ricette).
# Mealie's BASE_URL (used for the OIDC callback) is built from it as
# https://<MEALIE_SUBDOMAIN>.<DOMAIN>, so there is no separate URL variable.
MEALIE_SUBDOMAIN=ricette

# Proxies whose X-Forwarded-For / X-Forwarded-Proto Mealie trusts (HOST_IP): the
# traefik-proxy network subnet (private Traefik) and the public-mealie backend
# network subnet (traefik-public). Comma-separated IPs/CIDRs.
MEALIE_TRUSTED_PROXIES=172.27.0.0/16,172.16.83.0/28

# OIDC / SSO configuration
OIDC_CLIENT_ID=your-oidc-client-id-here
OIDC_CLIENT_SECRET=your-oidc-client-secret-here
OIDC_CONFIGURATION_URL=https://your-oidc-provider.example.com/.well-known/openid-configuration

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
