TZ=Europe/Zurich

# Volume base paths (fast config storage vs bulk data storage).
# SQLite database and app state go to ${VOLUME_CONFIG}/trek/data,
# uploaded files to ${VOLUME_DATA}/trek/uploads.
VOLUME_CONFIG=/opt/docker
VOLUME_DATA=/opt/docker-data

TREK_SUBDOMAIN=trek

# Public base URL of the instance; must equal https://<TREK_SUBDOMAIN>.<DOMAIN>.
# Used for CORS, cookies and the links in notification emails.
TREK_APP_URL=https://trek.example.com

# First-boot admin only; ignored once any user exists.
TREK_ADMIN_EMAIL=admin@example.com
TREK_ADMIN_PASSWORD=change-me-strong-password

# Generate with: openssl rand -hex 32. Keep a copy outside the backups: losing it
# makes the stored API keys and secrets unreadable.
TREK_ENCRYPTION_KEY=64-character-hex-string-generate-with-openssl-rand-hex-32

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin

# Only used by the commented-out OIDC block in the compose file
TREK_OIDC_CLIENT_SECRET=your-trek-oidc-client-secret-here
TREK_OIDC_ISSUER=https://pocket-id.example.com
