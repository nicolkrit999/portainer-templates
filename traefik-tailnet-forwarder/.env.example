# This instance's Tailscale node IP (nicol-nas) - the HAProxy frontend
# binds directly to this address on :443. Must match the same value used
# elsewhere in this repo for this node (e.g. dnsmasq-tailnet's TAILNET_IP).
TAILSCALE_IP=100.101.189.91

# Traefik's own static IP on the traefik-proxy Docker network (set via
# ipv4_address in ../traefik/docker-compose.yml). Must be a free address
# within that network's subnet (confirmed live: 172.27.0.0/16). Required
# because this sidecar runs network_mode: host and cannot reach Traefik by
# container name/DNS - only by fixed IP.
TRAEFIK_INTERNAL_IP=172.27.255.250

# Container-internal-only port Traefik's new tailnet entrypoint listens on
# (must match TRAEFIK_PORT_7 in the traefik stack's own env - this sidecar
# forwards to ${TRAEFIK_INTERNAL_IP}:${TRAEFIK_PORT_7} with send-proxy-v2).
# Never published to any host port.
TRAEFIK_PORT_7=8446

# Volume base path (fast/SSD-class config storage) - haproxy.cfg lives at
# ${VOLUME_CONFIG}/traefik-tailnet-forwarder/haproxy.cfg on the host.
VOLUME_CONFIG=/volume2/docker
