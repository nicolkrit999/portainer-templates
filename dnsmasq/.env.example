# Not consumed by the dnsmasq image itself (this image has no TZ support -
# verified against its Dockerfile, which is plain Alpine with no tzdata
# package). Kept here only for repo-wide consistency with other services'
# .env files; safe to leave unset.
TZ=Europe/Zurich

# Wildcard domain this dnsmasq stopgap answers for. All subdomains of this
# domain resolve to DNS_TARGET_IP below via dnsmasq's --address=/domain/ip
# syntax, which natively covers the domain and every subdomain.
DNS_WILDCARD_DOMAIN=example.com

# LAN IP that DNS_WILDCARD_DOMAIN (and all its subdomains) should resolve to
# - typically the NAS's own LAN IP.
DNS_TARGET_IP=192.168.1.98

# Dedicated private-tier IP. The per-hostname --address overrides in
# docker-compose.yml point specific private-tier-only hostnames at this IP
# instead of the general DNS_TARGET_IP above - dnsmasq prefers the more
# specific hostname match over the broader wildcard domain match.
DNS_PRIVATE_IP=192.168.1.99
