# Wildcard domain this dnsmasq answers for. The domain and every subdomain
# resolve to DNS_PRIVATE_IP below via dnsmasq's --address=/domain/ip syntax.
DNS_WILDCARD_DOMAIN=example.com

# The NAS's own LAN IP. Only used for the single non-HTTP override
# gitea-ssh.${DNS_WILDCARD_DOMAIN} (Git over SSH is published on the NAS itself,
# host port 2222, and never goes through Traefik).
DNS_TARGET_IP=192.168.1.98

# LAN IP of traefik-private-forwarder (macvlan). Every other name under
# DNS_WILDCARD_DOMAIN resolves here, so every service is reached through the
# private Traefik entrypoint. No per-service entries exist any more.
DNS_PRIVATE_IP=192.168.1.99

# The macvlan-host-shim IP (set in ../macvlan-host-shim/.env.example as
# MACVLAN_SHIM_IP - must match that value exactly). dnsmasq binds this
# directly since 2026-09-08 - the socat relay that used to sit in front of
# it was removed, see ../adguard/INCIDENT-2026-09-08-dns-relay-outage.md.
MACVLAN_SHIM_IP=192.168.1.95
