# User IDs
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker-data

# Host port
JELLYFIN_HOST_PORT=8196

# Traefik router subdomain (family + guest tiers)
JELLYFIN_SUBDOMAIN=jellyfin

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_4=friends
TRAEFIK_ENTRYPOINT_3=private
