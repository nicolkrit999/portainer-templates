DOCKER_CONFIG_DIR=/opt/docker
TZ=Europe/London
PUID=1000
PGID=1000
GROCY_SUBDOMAIN=grocy

# --- SAN-bundled TLS cert vars ("household-travel" group) ---
# These are NOT grocy's own settings. grocy's router is the anchor for a
# 6-group Let's Encrypt SAN-bundle (see docker-compose.yml comment above the
# tls.domains labels). Traefik needs each sibling hostname resolvable in
# THIS stack's env at deploy time to build the SAN list, so they're
# duplicated here with the same default values as each sibling service's
# own .env.example - do not change these without also checking the sibling
# service's own file.
HOMEBOX_SUBDOMAIN=homebox
HOMEHUB_SUBDOMAIN=casa
MEALIE_SUBDOMAIN=ricette
SPARKYFITNESS_SUBDOMAIN=sparkyfitness
VIKUNJA_SUBDOMAIN=promemoria
EASY_APPOINTMENTS_SUBDOMAIN=appuntamenti
HOME_ASSISTANT_SUBDOMAIN=home-assistant
SURMAI_SUBDOMAIN=viaggi
TREK_SUBDOMAIN=trek

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_3=private
