# ============================================================================
# Merged .env.example (2026-09-08) - combines the former
# ../tailscale-admin/.env.example and ../traefik-tailnet-forwarder/.env.example
# into one, since both services now live in one compose file/one Portainer
# stack. VOLUME_CONFIG was declared in both originals and is deduplicated to
# one entry below - it's the same value for both services.
# ============================================================================

# --- tailscale-admin -----------------------------------------------------

# Reusable (non-ephemeral) Tailscale pre-auth key for this node, generated
# manually via the Tailscale admin console (Settings -> Keys). Tag it
# appropriately there if your tailnet uses ACL tags. Set the real value
# directly in Portainer - never commit it here.
TS_AUTHKEY_ADMIN=your-tailscale-preauth-key-here

# Distinct, human-readable node name for this second Tailscale identity, so
# it's clearly identifiable (and separately approvable) in the admin
# console, distinct from the primary node in ../tailscale/.
TS_HOSTNAME_ADMIN=traefik-admin-gateway

# Static IP for the tailscale-admin service on the traefik-proxy Docker
# network - required so Traefik's proxyProtocol.trustedIPs (set on the
# tailnet-admin entrypoint) can trust PROXY protocol headers from a known,
# stable address rather than Docker's dynamically-assigned one. Must be a
# free address within traefik-proxy's subnet (confirmed live:
# 172.27.0.0/16), distinct from Traefik's own static IP
# (TRAEFIK_INTERNAL_IP below, 172.27.255.250).
TAILSCALE_ADMIN_INTERNAL_IP=172.27.255.249

# --- traefik-tailnet-forwarder (haproxy) ----------------------------------

# tailscale-admin's OWN tailnet IP (NOT the primary node's IP in
# ../tailscale/, and NOT a hardcoded real value - every deployer's
# tailscale-admin node gets a different IP assigned by Tailscale). The
# HAProxy frontend binds directly to this address on :443/:80. This value
# is only known AFTER tailscale-admin has been deployed and approved in
# your tailnet's admin console - look it up there
# (https://login.tailscale.com/admin/machines), find the device matching
# TS_HOSTNAME_ADMIN above, and use its assigned 100.x.x.x address.
# CORRECTED 2026-09-08: this var previously held a real, stale, pre-merge
# IP left over from a superseded network_mode: host design - it must always
# be tailscale-admin's current tailnet IP, re-checked after any redeploy
# that could have re-created that node (a re-created Tailscale identity can
# get a different tailnet IP).
TAILSCALE_IP=100.x.x.x

# Traefik's own static IP on the traefik-proxy Docker network (set via
# ipv4_address in ../traefik/docker-compose.yml). Must be a free address
# within that network's subnet (confirmed live: 172.27.0.0/16). Required
# because the forwarder shares tailscale-admin's network namespace
# (network_mode: container:tailscale-admin) and has no DNS resolution of
# its own there - only reachable by this fixed IP.
TRAEFIK_INTERNAL_IP=172.27.255.250

# Container-internal-only port Traefik's tailnet-admin entrypoint listens on
# (must match TRAEFIK_PORT_7 in the traefik stack's own env - this sidecar
# forwards to ${TRAEFIK_INTERNAL_IP}:${TRAEFIK_PORT_7} with send-proxy-v2).
# Never published to any host port.
TRAEFIK_PORT_7=8446

# --- tailscale-admin-watcher (added 2026-09-08, permanent fix for this
# pair's residual staleness risk - see the compose file's top-of-file
# comment and .claude/rules/core-infra-topology.md) ------------------------

# Seconds the watcher waits after tailscale-admin (re)starts before force-
# recreating traefik-tailnet-forwarder - gives the new Tailscale identity
# time to actually establish its tailnet connection first.
WATCHER_RESTART_WAIT_TIME=15

# This exact stack's own Portainer-assigned numeric stack ID. Portainer
# stores git-stack files on the host at
# <portainer-data-dir>/compose/<stack-id>/<stack-directory-name>/docker-compose.yml
# - the watcher mounts that exact file so it can run `docker compose up`
# with full fidelity instead of reconstructing the command by hand. Look
# this up via Portainer's own stack list/inspect for THIS stack.
# The value below (350) is the real, currently-confirmed-live value for
# this deployment (confirmed via Portainer StackInspect, 2026-09-08) - it
# is NOT a fixed constant. It MUST be re-verified if this stack is ever
# deleted and recreated, which assigns a brand-new stack ID.
PORTAINER_STACK_ID=350

# --- shared ----------------------------------------------------------------

# Volume base path (fast/SSD-class config storage) - tailscale-admin's state
# lives at ${VOLUME_CONFIG}/tailscale-admin/state, the forwarder's
# haproxy.cfg lives at ${VOLUME_CONFIG}/traefik-tailnet-forwarder/haproxy.cfg,
# and Portainer's own data dir (used by tailscale-admin-watcher to locate
# this stack's compose file) lives at ${VOLUME_CONFIG}/portainer - all on
# the same host.
VOLUME_CONFIG=/volume2/docker
