DOCKER_CONFIG_DIR=/opt/docker

# Application credentials (initial login — change after first login)
STIRLING_PDF_USERNAME=your-username-here
STIRLING_PDF_PASSWORD=your-password-here

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
STIRLING_PDF_SUBDOMAIN=stirling-pdf

# Host port for direct LAN-IP access (bypasses Traefik/Cloudflare)
STIRLING_PDF_HOST_PORT=8085
