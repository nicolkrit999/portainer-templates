# User IDs
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Admin username for the web UI
ADMIN_USER=admin

# Web UI password
PASSWORD=your-secure-password-here

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker-data

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
BLENDER_SUBDOMAIN=blender
