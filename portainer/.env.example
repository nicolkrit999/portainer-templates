# Timezone
TZ=Europe/Zurich

# Base domain (routers are host-matched as <service>.DOMAIN)
DOMAIN=example.com

# Volume base path (fast/SSD-class config storage) - Portainer's /data
# lives at ${VOLUME_CONFIG}/portainer and holds state for every stack
# managed by this Portainer instance. Preserve the exact live host path
# when migrating - do not change this value on an existing deployment.
VOLUME_CONFIG=/volume2/docker

# Traefik reverse-proxy hostname (subdomain segment only, combined with ${DOMAIN})
PORTAINER_SUBDOMAIN=portainer

# --- SAN-bundled TLS cert vars ("infra-ops" group) ---
# These are NOT portainer's own settings. portainer's router is the anchor
# for a 6-group Let's Encrypt SAN-bundle (see docker-compose.yml comment
# above the tls.domains labels). Traefik needs each sibling hostname
# resolvable in THIS stack's env at deploy time to build the SAN list, so
# they're duplicated here with the same default values as each sibling
# service's own .env.example - do not change these without also checking
# the sibling service's own file.
COOLIFY_SUBDOMAIN=coolify
SOKETI_SUBDOMAIN=soketi-coolify
GITEA_SUBDOMAIN=gitea
TUGTAINER_SUBDOMAIN=tugtainer
DOCKPEEK_SUBDOMAIN=dockpeek
HARBORGUARD_SUBDOMAIN=harborguard
BESZEL_SUBDOMAIN=beszel
UPTIME_KUMA_SUBDOMAIN=uptime-kuma
GLANCES_SUBDOMAIN=glances
GLANCE_SUBDOMAIN=glance
GOCRON_SUBDOMAIN=gocron
N8N_SUBDOMAIN=n8n
POCKET_ID_SUBDOMAIN=pocket-id
ADGUARD_SUBDOMAIN=adguard
UPSNAP_SUBDOMAIN=upsnap
APPRISE_API_SUBDOMAIN=apprise-api
GOTIFY_SUBDOMAIN=gotify
WEB_CHECK_SUBDOMAIN=web-check
MAILPIT_SUBDOMAIN=mailpit
PHPLDAPADMIN_SUBDOMAIN=phpldapadmin
# Traefik's own dashboard hostname is a hardcoded "traefik" literal inside
# traefik/docker-compose.yml itself (not a ${VAR} there), so this var exists
# ONLY here, to let portainer's anchor router reference it in the SAN list.
TRAEFIK_DASHBOARD_SUBDOMAIN=traefik

# Shared Traefik vars (repo-wide, same value across every service's stack)
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
