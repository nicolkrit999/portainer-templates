# Timezone
TZ=Europe/Zurich

# Base domain (routers are host-matched as <service>.DOMAIN)
DOMAIN=example.com

# Volume base path (fast/SSD-class config storage) - Portainer's /data
# lives at ${VOLUME_CONFIG}/portainer and holds state for every stack
# managed by this Portainer instance. Preserve the exact live host path
# when migrating - do not change this value on an existing deployment.
VOLUME_CONFIG=/volume2/docker

# Traefik reverse-proxy hostname (subdomain segment only, combined with ${DOMAIN})
PORTAINER_SUBDOMAIN=portainer

# Shared Traefik vars (repo-wide, same value across every service's stack)
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
