# Timezone
TZ=America/New_York

# Host UID to run the container as (SET_USER)
PUID=1000

# Cosmetic display name shown in the OpenSpeedTest UI
OPENSPEEDTEST_SERVER_NAME=Home Speedtest

# Traefik subdomain (defaults to the service directory name)
OPENSPEEDTEST_SUBDOMAIN=openspeedtest

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_4=friends
