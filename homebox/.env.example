DOCKER_CONFIG_DIR=/opt/docker
TZ=Europe/London
HOMEBOX_SUBDOMAIN=homebox

# Server-side secret mixed into stored API key hashes. Generate with: openssl rand -base64 48
# Must stay stable across restarts: rotating it invalidates every issued API key.
HBOX_AUTH_API_KEY_PEPPER=your-hbox-pepper-here

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
