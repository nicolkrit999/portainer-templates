# Timezone (matches NAS and OpenCloud; active-hours window uses this)
TZ=Europe/Zurich

# ── OpenCloud WebDAV connection (same credentials as icorsi-sync) ────────────
OPENCLOUD_USER=your-opencloud-username
OPENCLOUD_APP_PASSWORD=your-opencloud-app-password
# Spaces-based WebDAV URL: https://<host>/dav/spaces/<space-id>, where <space-id>
# is "<storage-uuid>$<node-uuid>". OpenCloud's web UI only shows you a WebDAV
# link scoped to whatever folder you're currently browsing (Files -> a folder ->
# Details) - drop everything after the space id itself to get the space's ROOT
# url (browsable full contents, not one subfolder). The space id is also the
# container's data dir name under storage/users/projects/<node-uuid>.
# Everything under OPENCLOUD_BASE_PATH below is relative to this space's root,
# not a personal-files home.
OPENCLOUD_WEBDAV_URL=http://opencloud:9200/dav/spaces/your-storage-uuid$your-node-uuid
# Trusted domain to send as the HTTP Host header when hitting the container
# directly. May not be required by OpenCloud (unlike classic ownCloud) - leave
# blank and test first; only set this if requests get rejected.
OPENCLOUD_HOST_HEADER=opencloud.example.com
# Base folder inside the space - courses.json paths are relative to this.
# Empty ("") if courses.json's keys are already relative to the space root.
OPENCLOUD_BASE_PATH=

# ── Discord notification webhook (optional) ─────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-here

# ── Scheduling ──────────────────────────────────────────────────────────────
# How often to check for new _icorsi/ material (seconds). Default: 6 h.
NOTES_INTERVAL_SECONDS=21600
# How long to sleep after hitting the Max plan rate/usage limit (seconds). Default: 1 h.
LIMIT_BACKOFF_SECONDS=3600
# Run once on container start before the first sleep interval.
RUN_ON_START=true
# Dry-run mode: list which courses would be noted, invoke nothing.
DRY_RUN=false

# Cost circuit-breaker: halt if claude -p reports any non-zero total_cost_usd.
# Compose default: true. ON A MAX/PRO SUBSCRIPTION SET THIS TO false: the CLI always
# reports the list-price equivalent of the tokens used (costBasis "list"), even though
# nothing is billed, so the value is non-zero on every normal run and the breaker halts
# the pass after the first completed course. Nothing in the response distinguishes
# subscription usage from paid 'extra usage'. The real billing guards are: no
# ANTHROPIC_API_KEY in the environment (startup assertion) and 'extra usage' OFF on
# your Anthropic account.
COST_CIRCUIT_BREAKER=false

# ── Active-hours window ──────────────────────────────────────────────────────
# Claude runs ONLY within this local-time window (uses TZ above).
# Empty string = always active.  Overnight ranges (e.g. 23:00-06:00) are supported.
# Default 00:00-03:00 rationale: if a run hits the 5-hour Max limit at 03:00, the
# session resets ~08:00 -- well before a typical morning. A window ending at 07:00
# would push the reset to ~noon if a limit hit at the very end.
ACTIVE_HOURS=00:00-03:00

# Minimum seconds left in the window required to START a new course.
# Prevents starting a course that cannot reach a clean section boundary.
# Default: 1800 (30 min).
MIN_TASK_WINDOW_SECONDS=1800

# Grace period (minutes) before the window end: daemon sends SIGTERM at
# (window_end - WINDOW_GRACE_MINUTES) to let claude write the final status block,
# then SIGKILL at window_end. Because writes are incremental (one section at a time),
# even a hard kill leaves _suggested/_notes.md in a consistent state.
# Default: 10 min.
WINDOW_GRACE_MINUTES=10

# ── Optional: force a specific Claude model ──────────────────────────────────
# Leave empty to use the default model from the subscription.
CLAUDE_MODEL=

# ── Volume base paths ────────────────────────────────────────────────────────
DOCKER_CONFIG_DIR=/volume2/docker

# ── NOTE: ANTHROPIC_API_KEY is intentionally absent ─────────────────────────
# This service uses your Claude Max subscription (OAuth token stored in the
# /root/.claude volume).  The daemon refuses to start if any billing-capable
# credential (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, CLAUDE_CODE_USE_BEDROCK,
# CLAUDE_CODE_USE_VERTEX) is present -- hard startup assertion, not just omission.
#
# COST_CIRCUIT_BREAKER (see above) would write /data/HALT on any
# non-zero total_cost_usd - but that value is the list-price equivalent on every run
# under a subscription, so it cannot detect extra-usage billing. Keep 'extra usage'
# disabled on the Anthropic account instead. Remove /data/HALT to resume if it was set.
