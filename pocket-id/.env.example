# User IDs
PUID=1000
PGID=1000

# App settings
APP_URL=https://id.example.com
TRUST_PROXY=true

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# Traefik private-tier router hostname segment (pocket-id.${DOMAIN})
POCKET_ID_SUBDOMAIN=pocket-id

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
