# User IDs
PUID=1000
PGID=1000

# App settings
APP_URL=https://id.example.com
TRUST_PROXY=true

# Mandatory since Pocket-ID v2 (random, at least 16 characters): encrypts sensitive data such as the token signing
# keys in the database. Generate with `openssl rand -base64 32`, set it only in the Portainer stack env and keep a copy
# outside the repo. Do not change it by editing the variable: rotate it with `pocket-id encryption-key-rotate`.
ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# Traefik private-tier router hostname segment (pocket-id.${DOMAIN})
POCKET_ID_SUBDOMAIN=pocket-id

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
