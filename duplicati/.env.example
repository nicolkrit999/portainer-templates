# Timezone (note: PUID/PGID are intentionally 0/root for full backup access)
TZ=America/New_York

# Duplicati encryption and web UI password
DUPLICATI_SETTINGS_ENCRYPTION_KEY=your-settings-encryption-key-here
DUPLICATI_WEBSERVICE_PASSWORD=your-web-ui-password-here

# Volume base path for config
DOCKER_CONFIG_DIR=/opt/docker

# Source mounts - adjust to your filesystem layout
DUPLICATI_HOME_SOURCE=/home
DUPLICATI_SOURCE1=/mnt/volume1
DUPLICATI_SOURCE2=/mnt/volume2
DUPLICATI_RESTORE_TEMP=/tmp/duplicati-restore

# Host port
DUPLICATI_HOST_PORT=8200

# Traefik private-tier subdomain (defaults to the service directory name)
DUPLICATI_SUBDOMAIN=duplicati

# SAN-bundle group "utilities" - this stack is the anchor, so its own .env
# needs a subdomain var for every OTHER member of the group
IT_TOOLS_SUBDOMAIN=it-tools
OMNI_TOOLS_SUBDOMAIN=omnitools
CONVERTX_SUBDOMAIN=convertx
STIRLING_PDF_SUBDOMAIN=stirling-pdf
CHANGE_DETECTION_SUBDOMAIN=change-detection
FILEBROWSER_SUBDOMAIN=filebrowser
SNAPOTTER_SUBDOMAIN=snapotter
MOOCUP_SUBDOMAIN=moocup
WITHOUTBG_SUBDOMAIN=withoutbg
CARDYO_SUBDOMAIN=cardyo
DATETIME_SUBDOMAIN=datetime
TERMIX_SUBDOMAIN=termix
SNAPPYEMAIL_SUBDOMAIN=snappyemail
OWNCLOUD_SUBDOMAIN=owncloud
MINI_QR_SUBDOMAIN=miniqr
PRIVATEBIN_SUBDOMAIN=privatebin
BYTESTASH_SUBDOMAIN=bytestash
OPENRESUME_SUBDOMAIN=openresume
SOSSE_SUBDOMAIN=sosse

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
