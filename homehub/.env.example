DOCKER_CONFIG_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker-data

# Application secrets
SECRET_KEY=your-secret-key-here

# Traefik router subdomain (family tier)
HOMEHUB_SUBDOMAIN=casa

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
