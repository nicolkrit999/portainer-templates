# User IDs
PUID=1000
PGID=1000

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# This stack's own Portainer-assigned numeric stack ID (Portainer UI: Stacks > privatebin, shown in the URL).
# conf.php is mounted from the stack's git checkout at ${DOCKER_CONFIG_DIR}/portainer/compose/<id>/privatebin/,
# which requires Portainer's data directory to be ${DOCKER_CONFIG_DIR}/portainer. Required: the stack refuses to
# deploy without it. NOT a fixed constant - re-check it if the stack is ever deleted and recreated.
PORTAINER_STACK_ID=237

# Host port (published on 127.0.0.1 only)
PRIVATEBIN_HOST_PORT=8080

# Traefik hostname segment (privatebin.${DOMAIN})
PRIVATEBIN_SUBDOMAIN=privatebin

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
