# User IDs
PUID=1000
PGID=1000

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# Host port
PRIVATEBIN_HOST_PORT=8080

# Traefik private-tier router hostname segment (privatebin.${DOMAIN})
PRIVATEBIN_SUBDOMAIN=privatebin

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
