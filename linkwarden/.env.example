# NextAuth secret (random 32+ character string)
NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL for NextAuth
NEXTAUTH_URL=https://linkwarden.example.com

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# Traefik private-tier subdomain (defaults to the directory name)
LINKWARDEN_SUBDOMAIN=linkwarden

# SAN-bundle group "productivity-creative" - this stack is the anchor, so its
# own .env needs a subdomain var for every OTHER member of the group
AFFINE_SUBDOMAIN=affine
DRAWIO_SUBDOMAIN=draw-io
EXCALIDRAW_SUBDOMAIN=excalidraw
FOSSFLOW_SUBDOMAIN=fossflow
OPENNOTEBOOK_SUBDOMAIN=opennotebook
PAPERLESS_SUBDOMAIN=paperlessngx
HOLYCLAUDE_SUBDOMAIN=claude
BLENDER_SUBDOMAIN=blender
LIFEGLANCE_SUBDOMAIN=lifeglance
GHOST_SUBDOMAIN=blog

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
OPENNOTEBOOK_API_SUBDOMAIN=opennotebook-api
