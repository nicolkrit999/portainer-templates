# NextAuth secret (random 32+ character string)
NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED (the compose file refuses to deploy without it). Password of the bundled
# Postgres user (letters and digits only, it is embedded in a URL). Postgres only
# reads it on first init, so on an existing database it must equal the CURRENT
# database password until you rotate it with ALTER USER and update this value.
LINKWARDEN_DB_PASSWORD=change-me

# Timezone
TZ=Europe/Zurich

# OPTIONAL (the compose has this default). Subnet of the stack-internal linkwarden-backend network (app and database
# only; sits next to the public-linkwarden network, 172.16.91.0/28, created
# by the traefik-public stack, which must be deployed first)
LINKWARDEN_BACKEND_SUBNET=172.16.91.16/28

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# Traefik router hostname segment (linkwarden.${DOMAIN})
LINKWARDEN_SUBDOMAIN=linkwarden

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
