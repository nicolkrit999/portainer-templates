# Timezone
TZ=America/New_York

# User IDs
PUID=1000
PGID=1000

# Mailer settings
VIKUNJA_MAILER_HOST=smtp.gmail.com
VIKUNJA_MAILER_PORT=587

# Mailer credentials
VIKUNJA_MAILER_USERNAME=your-smtp-username@gmail.com
VIKUNJA_MAILER_PASSWORD=your-smtp-app-password
VIKUNJA_MAILER_FROMEMAIL=noreply@example.com

# JWT secret (random 32+ character string)
VIKUNJA_SERVICE_JWTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL
VIKUNJA_SERVICE_PUBLICURL=https://tasks.example.com

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# Traefik subdomain (legacy Cloudflare hostname override)
VIKUNJA_SUBDOMAIN=promemoria

# SAN-bundle group "household-travel" - this stack is the anchor, so its own
# .env needs a subdomain var for every OTHER member of the group
GROCY_SUBDOMAIN=grocy
HOMEBOX_SUBDOMAIN=homebox
HOMEHUB_SUBDOMAIN=casa
MEALIE_SUBDOMAIN=ricette
SPARKYFITNESS_SUBDOMAIN=sparkyfitness
EASY_APPOINTMENTS_SUBDOMAIN=appuntamenti
HOME_ASSISTANT_SUBDOMAIN=home-assistant
SURMAI_SUBDOMAIN=viaggi
TREK_SUBDOMAIN=trek

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_3=private
EASY_APPOINTMENTS_PMA_SUBDOMAIN=appuntamenti-pma
EASY_APPOINTMENTS_SWAGGER_SUBDOMAIN=appuntamenti-swagger
EASY_APPOINTMENTS_BAIKAL_SUBDOMAIN=appuntamenti-baikal
