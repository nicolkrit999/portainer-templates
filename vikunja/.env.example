# Timezone
TZ=America/New_York

# User IDs
PUID=1000
PGID=1000

# Mailer settings
VIKUNJA_MAILER_HOST=smtp.gmail.com
VIKUNJA_MAILER_PORT=587

# Mailer credentials
VIKUNJA_MAILER_USERNAME=your-smtp-username@gmail.com
VIKUNJA_MAILER_PASSWORD=your-smtp-app-password
VIKUNJA_MAILER_FROMEMAIL=noreply@example.com

# JWT secret (random 32+ character string)
VIKUNJA_SERVICE_JWTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED. Password of the bundled Postgres user. Postgres only reads it on first init, so on an
# existing database it must equal the CURRENT database password until you rotate it with ALTER USER.
VIKUNJA_DB_PASSWORD=change-me

# Public URL; must equal https://<VIKUNJA_SUBDOMAIN>.<DOMAIN>
VIKUNJA_SERVICE_PUBLICURL=https://promemoria.example.com

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# Traefik hostname segment (the hostname differs from the directory name: promemoria)
VIKUNJA_SUBDOMAIN=promemoria

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
TRAEFIK_ENTRYPOINT_7=tailnet-admin
