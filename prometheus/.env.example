# SSD/NVMe-class pool root - prometheus.yml config bind mount
VOLUME_CONFIG=/volume2/docker
# HDD-class bulk pool root - Prometheus TSDB data (must be chown 65534:65534
# on the host under <VOLUME_DATA>/prometheus before first deploy, see
# docker-compose.yml comments)
VOLUME_DATA=/volume1/Default-volume-1/0001_Docker
