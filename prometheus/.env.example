# SSD/NVMe-class pool root - prometheus.yml config bind mount and Prometheus
# TSDB data (small, frequent, IOPS-sensitive writes/compactions - fast pool,
# not bulk). The prometheus-init service chowns <VOLUME_CONFIG>/prometheus to
# 65534:65534 on every deploy. prometheus.yml is read from
# <VOLUME_CONFIG>/prometheus/prometheus.yml (host copy, see docker-compose.yml).
VOLUME_CONFIG=/volume2/docker
