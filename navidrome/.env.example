DOCKER_CONFIG_DIR=/opt/docker

# Traefik subdomain
NAVIDROME_SUBDOMAIN=navidrome

# User/group IDs
PUID=1000
PGID=1000

# Music library directories (mounted as read-only into the container, put as many as needed)
MUSIC_DIR_1=/mnt/music/user1
MUSIC_DIR_2=/mnt/music/user2
MUSIC_DIR_3=/mnt/music/user3

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_1=family
TRAEFIK_ENTRYPOINT_2=guest
TRAEFIK_ENTRYPOINT_3=private

# Host port for direct LAN-IP access (bypasses Traefik/Cloudflare)
NAVIDROME_HOST_PORT=4533
