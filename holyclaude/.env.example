# User IDs
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Anthropic API key (uncomment the env var in the compose to activate)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Volume base paths
DOCKER_CONFIG_DIR=/opt/docker

# Shared Traefik vars (repo-wide, same value across every service's stack)
DOMAIN=example.com
TRAEFIK_ENTRYPOINT_3=private
HOLYCLAUDE_SUBDOMAIN=claude
